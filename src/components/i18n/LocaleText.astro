---
import type { LocaleText } from '../../types/profile.types'

type Props = {
  text: LocaleText
  as?: keyof HTMLElementTagNameMap
  class?: string
}

const { text, as = 'span', class: className } = Astro.props as Props
const Tag = as
---

<Tag data-i18n data-i18n-en={text.en} data-i18n-id={text.id} class={className}>
  {text.en}
</Tag>
