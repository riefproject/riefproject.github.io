---
import socialData from '../../content/singletons/social.json'
import { profile } from '../../data/profile'
import {
  buildPersonSchema,
  buildWebSiteSchema,
  DEFAULT_DESCRIPTION,
  DEFAULT_DESCRIPTION_ID,
  type JsonLd,
} from '../../utils/seo'
import { localeFromPath, localizePath, stripLocalePath } from '../../utils/routing'

export interface Props {
  title?: string
  description?: string
  image?: string
  type?: 'website' | 'profile' | 'article'
  noindex?: boolean
  jsonLd?: JsonLd | JsonLd[]
}

const fontHref =
  'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap'

const {
  title = `${profile.name} — Software Engineer & Competitive Programmer`,
  description,
  image = '/og-image.jpg',
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props

const locale = localeFromPath(Astro.url.pathname)
const isId = locale === 'id'
const resolvedDescription = description ?? (isId ? DEFAULT_DESCRIPTION_ID : DEFAULT_DESCRIPTION)
const site = Astro.site ?? new URL(Astro.url.origin)
const siteUrl = site.href.replace(/\/$/, '')
const canonical = new URL(Astro.url.pathname, site)
const enPath = stripLocalePath(Astro.url.pathname)
const idPath = localizePath(enPath, 'id')
const ogImage = new URL(image, canonical)
const robots = noindex ? 'noindex, nofollow' : 'index, follow'
const meLinks = socialData.socials
  .map((social) => social.url)
  .filter((url) => url.startsWith('http'))
const schemas = [
  buildPersonSchema(siteUrl, locale),
  buildWebSiteSchema(siteUrl, locale),
  ...(Array.isArray(jsonLd) ? jsonLd
  : jsonLd ? [jsonLd]
  : []),
]
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Hi Res Favicon -->
<link rel="icon" type="image/png" sizes="972x972" href="/favicon.png" />
<!-- Google Search Favicon -->
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
<link rel="icon" type="image/png" sizes="144x144" href="/favicon-144.png" />
<!-- Apple / iOS -->
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<!-- Google Fonts (Non-blocking) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preload" as="style" href={fontHref} />
<link rel="stylesheet" href={fontHref} media="print" onload="this.removeAttribute('media')" />
<noscript>
  <link rel="stylesheet" href={fontHref} />
</noscript>

<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="en" href={new URL(enPath, site)} />
<link rel="alternate" hreflang="id" href={new URL(idPath, site)} />
<link rel="alternate" hreflang="x-default" href={new URL(enPath, site)} />
{meLinks.map((url) => (
  <link rel="me" href={url} />
))}
<meta name="robots" content={robots} />
<script defer data-domain="riefproject.my.id" src="https://plausible.io/js/script.js"></script>
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={resolvedDescription} />
<meta name="author" content={profile.name} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={profile.name} />
<meta property="og:locale" content={isId ? 'id_ID' : 'en_US'} />
<meta property="og:locale:alternate" content={isId ? 'en_US' : 'id_ID'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={resolvedDescription} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={resolvedDescription} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />

<script type="application/ld+json" set:html={JSON.stringify(schemas)} />
<script is:inline>
  ;(() => {
    const storageKey = 'portfolio-theme'
    let initial = 'light'
    try {
      const stored = typeof localStorage !== 'undefined' ? localStorage.getItem(storageKey) : null
      if (stored) {
        initial = stored
      } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
        initial = 'dark'
      }
    } catch (err) {
      initial = 'light'
    }
    if (initial === 'dark') {
      document.documentElement.classList.add('dark')
      document.documentElement.classList.remove('light')
    } else {
      document.documentElement.classList.add('light')
      document.documentElement.classList.remove('dark')
    }
  })()
</script>

<script is:inline>
  ;(() => {
    const storageKey = 'portfolio-lang'
    const normalizeLang = (value) => {
      if (typeof value !== 'string') return 'en'
      const normalized = value.toLowerCase()
      if (normalized === 'id' || normalized === 'in' || normalized.startsWith('id-')) {
        return 'id'
      }
      return 'en'
    }
    const persistLang = (lang) => {
      try {
        if (typeof localStorage !== 'undefined') {
          localStorage.setItem(storageKey, lang)
        }
      } catch (err) {
        // ignore storage write failure
      }
    }

    const applyLanguage = (rawLang) => {
      const lang = normalizeLang(rawLang)
      const root = document.documentElement
      root.classList.toggle('lang-id', lang === 'id')
      root.classList.toggle('lang-en', lang !== 'id')
      root.setAttribute('lang', lang === 'id' ? 'id' : 'en')
      const attribute = lang === 'id' ? 'data-i18n-id' : 'data-i18n-en'
      document.querySelectorAll('[data-i18n]').forEach((element) => {
        const value = element.getAttribute(attribute)
        if (value !== null && element.textContent !== value) {
          element.textContent = value
        }
      })
      const placeholderAttr =
        lang === 'id' ? 'data-i18n-placeholder-id' : 'data-i18n-placeholder-en'
      document.querySelectorAll('[data-i18n-placeholder-en]').forEach((element) => {
        const value = element.getAttribute(placeholderAttr)
        if (value !== null) {
          element.setAttribute('placeholder', value)
        }
      })
      document.querySelectorAll('[data-lang-toggle-fallback]').forEach((button) => {
        const segments = button.querySelectorAll('.segment')
        if (segments.length >= 2) {
          segments[0].classList.toggle('active', lang === 'en')
          segments[1].classList.toggle('active', lang === 'id')
        }
        button.setAttribute(
          'aria-label',
          lang === 'en' ? 'Switch language to Indonesian' : 'Change language to English'
        )
      })
    }
    const fallbackToggleLanguage = () => {
      const current = normalizeLang(document.documentElement.getAttribute('lang') ?? 'en')
      const next = current === 'en' ? 'id' : 'en'
      persistLang(next)

      const path = window.location.pathname
      const basePath =
        path === '/id' ? '/'
        : path.startsWith('/id/') ? path.slice(3) || '/'
        : path || '/'
      const targetPath =
        next === 'id' ?
          basePath === '/' ?
            '/id/'
          : `/id${basePath}`
        : basePath || '/'
      window.location.assign(`${targetPath}${window.location.search}${window.location.hash}`)
    }

    window.__applyLanguage = applyLanguage

    const initDeferredLang = () => {
      window.addEventListener('portfolio:lang-change', (event) => {
        const langFromEvent =
          event instanceof CustomEvent ? normalizeLang(event.detail) : document.documentElement.lang
        applyLanguage(langFromEvent)
      })
      window.addEventListener('storage', (event) => {
        if (event.key === storageKey && event.newValue) {
          applyLanguage(normalizeLang(event.newValue))
        }
      })
      document.addEventListener('click', (event) => {
        const target =
          event.target instanceof Element ?
            event.target.closest('[data-lang-toggle-fallback]')
          : null
        if (!target) return
        const island = target.closest('astro-island')
        if (island && !island.hasAttribute('ssr')) return
        event.preventDefault()
        fallbackToggleLanguage()
      })
    }

    const path = window.location.pathname
    const initial = normalizeLang(path === '/id' || path.startsWith('/id/') ? 'id' : 'en')

    const init = () => {
      applyLanguage(initial)
      initDeferredLang()
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true })
    } else {
      init()
    }
  })()
</script>
