---
import type { FocusArea, Profile } from '../../types/profile.types';
import LocaleText from '../i18n/LocaleText.astro';

const locale = (en: string, id: string) => ({ en, id });
const copy = {
	eyebrow: locale('About me', 'Tentang saya'),
	heading: locale('Turning ideas into shipped products with clear steps.', 'Mewujudkan ide jadi produk jalan dengan langkah yang jelas.'),
};

type AboutProps = {
	profile: Profile;
	focusAreas: FocusArea[];
};

const { profile, focusAreas } = Astro.props as AboutProps;
---

<section id="tentang" class="section about">
	<div class="about__intro surface">
		<p class="eyebrow">
			<LocaleText as="span" text={copy.eyebrow} />
		</p>
		<h2>
			<LocaleText as="span" text={copy.heading} />
		</h2>
		<p>
			<LocaleText as="span" text={profile.bio} />
		</p>
		<p class="about__availability">
			<LocaleText as="span" text={profile.availability} />
		</p>
	</div>
	<div class="about__areas grid">
		{focusAreas.map((area) => (
			<article class="surface">
				<h3>
					<LocaleText as="span" text={area.title} />
				</h3>
				<p>
					<LocaleText as="span" text={area.description} />
				</p>
				<ul>
					{area.items.map((item) => (
						<li>
							<LocaleText as="span" text={item} />
						</li>
					))}
				</ul>
			</article>
		))}
	</div>
</section>

<style>
	.about__intro h2 {
		font-family: inherit;
		margin: 0 0 1rem;
		font-size: clamp(1.75rem, 3.5vw, 2.25rem);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--text);
	}

	.about__intro p {
		color: var(--muted);
		line-height: 1.7;
		font-size: 1rem;
	}

	.about__areas {
		margin-top: 2rem;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
	}

	.about__areas article h3 {
		font-family: inherit;
		margin: 0 0 0.5rem;
		font-size: 1.15rem;
		font-weight: 600;
		color: var(--text);
	}

	.about__areas article p {
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.about__areas ul {
		padding-left: 1.1rem;
		margin: 0.75rem 0 0;
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.about__areas li {
		margin-bottom: 0.25rem;
	}

	.about__availability {
		color: var(--muted);
		font-size: 0.9rem;
		margin-top: 1rem;
	}
</style>
