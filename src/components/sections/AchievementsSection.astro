---
import type { Achievement, AchievementTab } from '../../types/profile.types'
import Achievements from './Achievements.vue'
import { localeFromPath } from '../../utils/routing'

type AchievementsProps = {
  items: Achievement[]
  tabs: AchievementTab[]
}

const { items, tabs } = Astro.props as AchievementsProps
const currentLocale = localeFromPath(Astro.url.pathname)
---

<section id="achievements" class="section achievements">
  <Achievements client:visible items={items} tabs={tabs} initialLocale={currentLocale} />
</section>

<style>
  .achievements {
    padding-top: clamp(2rem, 4svw, 4rem);
    padding-bottom: clamp(2rem, 4svw, 4rem);
  }
</style>
