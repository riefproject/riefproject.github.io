---
import type { CPProfile } from '../../types/profile.types'
import LocaleText from '../i18n/LocaleText.astro'
import SectionIntro from './SectionIntro.astro'
import ArrowLink from '../shared/ArrowLink.astro'
import EntityBadge from '../shared/EntityBadge.astro'
import initialCpData from '../../data/cp-data-initial.json'
import { t as locale } from '../../utils/i18n'

const copy = {
  eyebrow: locale('Competitive programming', 'Competitive programming'),
  heading: locale(
    'Profiles where I learn, compete, and track progress.',
    'Profil tempat saya belajar, berkompetisi, dan memantau progres.'
  ),
  body: locale(
    'Handles and links to the platforms I actively use for contests, upsolving, and drills.',
    'Handle dan tautan ke platform yang aktif saya pakai untuk kontes, upsolve, dan latihan.'
  ),
  viewProfile: locale('View profile', 'Lihat profil'),
  openDashboard: locale('Open Live CP Dashboard', 'Buka Dashboard CP Live'),
  summarySolved: locale('Solved', 'Selesai'),
  summarySubmissions: locale('Submissions', 'Submisi'),
  summaryPlatforms: locale('Platforms', 'Platform'),
}

const totalCpSolved = initialCpData?.overview?.totalSolved || 640
const totalCpSubmissions = initialCpData?.overview?.totalSubmissions || 1528

type Props = {
  profiles?: CPProfile[]
}

const { profiles = [] }: Props = Astro.props
---

<section id="cp-profiles" class="section cp-profiles">
  <SectionIntro
    class="cp-profiles__intro"
    eyebrow={copy.eyebrow}
    heading={copy.heading}
    body={copy.body}>
    <div class="cp-live-summary mt-3 flex items-center gap-3 text-xs text-muted flex-wrap">
      <span class="inline-flex items-center gap-1.5 text-text font-semibold">
        {totalCpSolved}+ <LocaleText as="span" text={copy.summarySolved} />
      </span>
      <span>•</span>
      <span>
        {totalCpSubmissions}+ <LocaleText as="span" text={copy.summarySubmissions} />
      </span>
      <span>•</span>
      <span>
        4 <LocaleText as="span" text={copy.summaryPlatforms} />
      </span>
    </div>
    <ArrowLink
      href="/competitive-programming"
      label={copy.openDashboard}
      class="cp-dashboard-cta group mt-4"
    />
  </SectionIntro>
  <div class="cp-profiles__grid">
    {profiles.map((item) => (
      <article class="surface cp-card">
        <div class="cp-card__header">
          <EntityBadge
            logo={item.logo}
            name={item.platform}
            fallbackText={item.platform.slice(0, 2).toUpperCase()}
            size={40}
            fontSize="1rem"
            boxed={Boolean(item.logo)}
          />
          <div class="cp-card__title-group">
            <p class="cp-handle platform">{item.platform}</p>
            <h6 class="m-0 p-0">@{item.handle}</h6>
          </div>
        </div>
        {item.note && (
          <p class="cp-card__note">
            <LocaleText as="span" text={item.note} />
          </p>
        )}
        <ArrowLink
          href={item.url}
          label={copy.viewProfile}
          class="cp-card__link"
          target="_blank"
          rel="noreferrer"
        />
      </article>
    ))}
  </div>
</section>

<style>
  .cp-profiles {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cp-profiles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .cp-card {
    display: grid;
    gap: 0.5rem;
  }

  .cp-card__header {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: center;
  }

  .cp-card__title-group {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .cp-card h3 {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.2;
    font-family: inherit;
  }

  .platform {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.1;
    color: var(--muted);
  }

  .cp-card__note {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .cp-card__link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0 0.3rem 0;
    /* border-radius: 12px; */
    /* border: 1px solid var(--border); */
    font-weight: 600;
    color: var(--accent);
    transition: border-color 0.2s ease;
  }

  .cp-card__link:hover {
    border-color: var(--accent);
  }

  .cp-dashboard-cta {
    display: inline-flex;
    align-items: center;
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
    font-size: 1rem;
    transition: color 0.2s ease;
    width: fit-content;
  }

  .cp-dashboard-cta:hover {
    color: var(--accent);
  }
  .cp-handle {
    margin: 0;
    padding: 0;
    font-size: 0.8rem;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 500;
    color: var(--muted);
  }
</style>
