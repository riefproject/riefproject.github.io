---
import type { LocaleText } from '../../types/profile.types'
import '../../styles/collapsible.css'
import LocaleTextSpan from '../i18n/LocaleText.astro'

export type CollapsibleContentProps = {
  collapsedHeight?: string
  fadeHeight?: string
  labelSize?: 'sm' | 'base'
  labelMargin?: string
  readMore?: LocaleText
  showLess?: LocaleText
  class?: string
}

const {
  collapsedHeight = '120px',
  fadeHeight = '3rem',
  labelSize = 'sm',
  labelMargin = '0.25rem',
  readMore = { en: 'Read details', id: 'Baca selengkapnya' },
  showLess = { en: 'Show less', id: 'Tampilkan lebih sedikit' },
  class: className = '',
} = Astro.props as CollapsibleContentProps

const toggleId = `collapsible-${Math.random().toString(36).slice(2, 9)}`
---

<div class:list={['collapsible', className]}>
  <input type="checkbox" id={toggleId} class="collapsible__toggle" />
  <div class="collapsible__body" style={`--collapsed-height: ${collapsedHeight};`}>
    <slot />
    <div class="collapsible__fade" style={`height: ${fadeHeight};`} aria-hidden="true"></div>
  </div>
  <label
    for={toggleId}
    class:list={['collapsible__label', labelSize === 'base' && 'collapsible__label--base']}
    style={`margin-top: ${labelMargin};`}>
    <span class="read-more">
      <LocaleTextSpan as="span" text={readMore} />
    </span>
    <span class="show-less">
      <LocaleTextSpan as="span" text={showLess} />
    </span>
  </label>
</div>
