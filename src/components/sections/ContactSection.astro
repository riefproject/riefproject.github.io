---
import type { Contact, SocialLink } from '../../types/profile.types'
import LocaleText from '../i18n/LocaleText.astro'
import SectionIntro from './SectionIntro.astro'
import FormField from './FormField.astro'
import { t as locale } from '../../utils/i18n'

const copy = {
  eyebrow: locale('Contact', 'Kontak'),
  heading: locale(
    'Ready to collaborate on your next idea.',
    'Siap kolaborasi untuk ide berikutnya.'
  ),
  nameLabel: locale('Name', 'Nama'),
  namePlaceholder: locale('Full name', 'Nama lengkap'),
  emailLabel: locale('Email', 'Email'),
  emailPlaceholder: locale('email@example.com', 'email@contoh.com'),
  subjectLabel: locale('Subject', 'Perihal'),
  subjectPlaceholder: locale(
    'Audit, redesign, mentoring, etc.',
    'Audit, redesign, mentoring, dll.'
  ),
  messageLabel: locale('Message', 'Pesan'),
  messagePlaceholder: locale('Share what you want to build.', 'Ceritakan apa yang ingin dibangun.'),
  submit: locale('Send message', 'Kirim pesan'),
  emailDt: locale('Email', 'Email'),
  waDt: locale('WhatsApp', 'WhatsApp'),
  formEyebrow: locale('Send a note', 'Kirim pesan'),
}

interface Props {
  contact: Contact
  socials: SocialLink[]
}

const { contact, socials } = Astro.props
---

<section id="kontak" class="section contact">
  <SectionIntro
    class="contact__details"
    eyebrow={copy.eyebrow}
    heading={copy.heading}
    body={contact.message}>
    <dl>
      <div>
        <dt>
          <LocaleText as="span" text={copy.emailDt} />
        </dt>
        <dd>
          <a href={`mailto:${contact.email}`} class="link-underline">
            {contact.email}
          </a>
        </dd>
      </div>
    </dl>
    <p class="availability">
      <LocaleText as="span" text={contact.availabilityNote} />
    </p>
    <div class="social-list">
      {socials.map((social: SocialLink) => (
        <a href={social.url} target="_blank" rel="me noopener noreferrer">
          {social.label}
        </a>
      ))}
    </div>
  </SectionIntro>
  <form class="surface contact__form" method="POST" action="https://formspree.io/f/mzzeavab">
    <p class="eyebrow">
      <LocaleText as="span" text={copy.formEyebrow} />
    </p>
    <FormField label={copy.nameLabel} name="name" placeholder={copy.namePlaceholder} required />
    <FormField
      label={copy.emailLabel}
      name="email"
      type="email"
      placeholder={copy.emailPlaceholder}
      required
    />
    <FormField label={copy.subjectLabel} name="subject" placeholder={copy.subjectPlaceholder} />
    <FormField
      label={copy.messageLabel}
      name="message"
      type="textarea"
      placeholder={copy.messagePlaceholder}
      required
    />
    <button class="btn primary" type="submit">
      <LocaleText as="span" text={copy.submit} />
    </button>
  </form>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  dl {
    display: grid;
    gap: 0.5rem;
    margin: 1rem 0;
  }

  dt {
    font-weight: 600;
    color: var(--muted);
  }

  dd {
    margin: 0;
    font-size: 1.1rem;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .contact__form :global(label) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .contact__form :global(input),
  .contact__form :global(textarea) {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.85rem;
    font-size: 0.95rem;
    color: var(--text);
    font-family: inherit;
    resize: vertical;
    transition: border-color 0.2s ease;
  }

  .contact__form :global(input:focus),
  .contact__form :global(textarea:focus) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-color: var(--accent);
  }

  .availability {
    margin-bottom: 1rem;
    font-size: 0.95rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
