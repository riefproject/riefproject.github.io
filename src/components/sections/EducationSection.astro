---
import type { Education } from '../../types/profile.types';
import LocaleText from '../i18n/LocaleText.astro';

const locale = (en: string, id: string) => ({ en, id });
const copy = {
	eyebrow: locale('Education', 'Pendidikan'),
	heading: locale('Where I studied and what I honed there.', 'Di mana saya belajar dan apa yang diasah di sana.'),
	body: locale('Highlights of programs and initiatives that shaped my foundation.', 'Rangkuman program dan inisiatif yang membentuk fondasi saya.'),
};

type EducationProps = {
	education?: Education[];
};

const { education = [] }: EducationProps = Astro.props;
const getBadge = (text?: string) => (text ? text : '');
---

<section id="education" class="section education">
	<div class="surface education__intro">
		<p class="eyebrow">
			<LocaleText as="span" text={copy.eyebrow} />
		</p>
		<h2>
			<LocaleText as="span" text={copy.heading} />
		</h2>
		<p>
			<LocaleText as="span" text={copy.body} />
		</p>
	</div>
	<div class="education__list">
		{education.map((edu) => (
			<article class="surface education-card">
				<header class="education-card__header">
					{edu.logo ? (
						<div class="edu-badge edu-badge--image">
							<img src={edu.logo} alt={edu.institution} loading="lazy" />
						</div>
					) : (
						<div class="edu-badge">{getBadge(edu.institution.slice(0, 3).toUpperCase())}</div>
					)}
					<div>
						<p class="eyebrow">{edu.period}</p>
						<h3>{edu.institution}</h3>
						<p class="program">
							<LocaleText as="span" text={edu.program} />
						</p>
					</div>
				</header>
				<ul>
					{edu.details.map((detail) => (
						<li>
							<LocaleText as="span" text={detail} />
						</li>
					))}
				</ul>
			</article>
		))}
	</div>
</section>

<style>
	.education__intro h2 {
		margin: 0 0 0.5rem;
		font-size: clamp(2rem, 4svw, 2.4rem);
	}

	.education__list {
		margin-top: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.education-card h3 {
		margin: 0;
		font-size: 1.4rem;
	}

	.education-card .program {
		margin: 0.1rem 0 0.5rem;
		font-weight: 600;
		color: var(--muted);
	}

	.education-card ul {
		margin: 0.5rem 0 0;
		padding-left: 1.1rem;
		color: var(--muted);
	}

	.education-card ul li + li {
		margin-top: 0.3rem;
	}

	.education-card__header {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.75rem;
		align-items: center;
	}

	.edu-badge {
		width: 56px;
		height: 56px;
		border-radius: 16px;
		display: grid;
		place-items: center;
		font-weight: 700;
		font-size: 0.9rem;
		color: #0f172a;
		background: linear-gradient(135deg, #c7d2fe, #a5b4fc, #c7d2fe);
		border: 1px solid var(--border);
		text-align: center;
		padding: 0.35rem;
	}

	.edu-badge--image {
		background: var(--bg-elevated);
	}

	.edu-badge--image img {
		max-height: 44px;
		width: auto;
		display: block;
	}
</style>
