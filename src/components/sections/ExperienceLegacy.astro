---
import type { Experience } from '../../data/profile';
import LocaleText from '../i18n/LocaleText.astro';

type Props = {
	experiences: Experience[];
};

const { experiences }: Props = Astro.props;
const primary = experiences[0];
const secondary = experiences.slice(1);
---

<section id="experience" class="section legacy-exp">
	<div class="legacy-exp__content">
		<div class="legacy-exp__media">
			<div class="badge">
				<span>Brainware<br />of SMANSA</span>
			</div>
		</div>
		<div class="legacy-exp__details surface">
			<p class="eyebrow">
				<LocaleText as="span" text={primary.role} />
			</p>
			<h3>{primary.company}</h3>
			<p class="period">{primary.period}</p>
			<p>
				<LocaleText as="span" text={primary.summary} />
			</p>
			<ul>
				{primary.achievements.map((item) => (
					<li>
						<LocaleText as="span" text={item} />
					</li>
				))}
			</ul>
		</div>
	</div>
	{secondary.length > 0 && (
		<div class="legacy-exp__list">
			{secondary.map((exp) => (
				<article class="surface">
					<header>
						<h4>{exp.company}</h4>
						<p class="period">{exp.period}</p>
					</header>
					<p>
						<LocaleText as="span" text={exp.summary} />
					</p>
					<ul>
						{exp.achievements.map((item) => (
							<li>
								<LocaleText as="span" text={item} />
							</li>
						))}
					</ul>
				</article>
			))}
		</div>
	)}
</section>

<style>
	.legacy-exp__content {
		display: grid;
		grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
		gap: 1.25rem;
		align-items: stretch;
		margin-bottom: 2rem;
	}

	.legacy-exp__media {
		border-radius: 1.5rem;
		background: linear-gradient(135deg, #1d4ed8, #38bdf8);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem;
	}

	.badge {
		color: #ffffff;
		font-weight: 600;
		text-align: center;
		font-size: 1.1rem;
		line-height: 1.4;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.legacy-exp__details h3 {
		margin: 0 0 0.25rem;
		font-size: 1.5rem;
	}

	.period {
		margin: 0 0 1rem;
		font-weight: 600;
		color: var(--muted);
	}

	.legacy-exp__details ul {
		margin: 1rem 0 0;
		padding-left: 1.2rem;
		color: var(--muted);
	}

	.legacy-exp__list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1rem;
	}

	.legacy-exp__list h4 {
		margin: 0;
	}

	.legacy-exp__list ul {
		margin: 0.75rem 0 0;
		padding-left: 1.2rem;
		color: var(--muted);
	}

	@media (max-width: 960px) {
		.legacy-exp__content {
			grid-template-columns: 1fr;
		}
	}
</style>
