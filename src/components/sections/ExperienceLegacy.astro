---
import type { Experience } from '../../types/profile.types';
import LocaleText from '../i18n/LocaleText.astro';

const locale = (en: string, id: string) => ({ en, id });

type Props = {
	workExperiences?: Experience[];
	organizationalExperiences?: Experience[];
	personalExperiences?: Experience[];
};

const {
	workExperiences = [],
	organizationalExperiences = [],
	personalExperiences = [],
}: Props = Astro.props;

const groups = [
	{
		key: 'work',
		eyebrow: locale('Work Experience', 'Pengalaman Kerja'),
		heading: locale(
			'Professional roles with direct learner impact.',
			'Peran profesional dengan dampak langsung untuk pelajar.',
		),
		body: locale(
			'Paid and structured responsibilities focused on measurable outcomes and delivery.',
			'Tanggung jawab berbayar dan terstruktur dengan fokus pada hasil terukur dan eksekusi.',
		),
		items: workExperiences,
	},
	{
		key: 'organization',
		eyebrow: locale('Organizational Experience', 'Pengalaman Organisasi'),
		heading: locale(
			'Leadership and contribution in academic communities.',
			'Kepemimpinan dan kontribusi di komunitas akademik.',
		),
		body: locale(
			'Committee and student-organization roles that strengthened coordination and program execution.',
			'Peran kepanitiaan dan organisasi mahasiswa yang mengasah koordinasi serta eksekusi program.',
		),
		items: organizationalExperiences,
	},
	{
		key: 'personal',
		eyebrow: locale('Personal Journey', 'Perjalanan Personal'),
		heading: locale(
			'Independent growth through continuous problem solving.',
			'Pertumbuhan mandiri melalui problem solving berkelanjutan.',
		),
		body: locale(
			'Self-driven practice, mentoring, and long-term consistency across competitive programming platforms.',
			'Latihan mandiri, mentoring, dan konsistensi jangka panjang di berbagai platform competitive programming.',
		),
		items: personalExperiences,
	},
].filter((group) => group.items.length > 0);
---

<section id="experience" class="section legacy-exp">
	{groups.map((group) => {
		const primary = group.items[0];
		const secondary = group.items.slice(1);

		return (
			<div class="legacy-exp__group">
				<div class="surface legacy-exp__intro">
					<p class="eyebrow">
						<LocaleText as="span" text={group.eyebrow} />
					</p>
					<h2>
						<LocaleText as="span" text={group.heading} />
					</h2>
					<p>
						<LocaleText as="span" text={group.body} />
					</p>
				</div>

				<div class="legacy-exp__content">
					<div class="legacy-exp__media">
						{primary.logo ? (
							<div class="badge badge--image">
								<img src={primary.logo} alt={primary.company} loading="lazy" />
							</div>
						) : (
							<div class="badge">
								<span>{primary.company}</span>
							</div>
						)}
					</div>
					<div class="legacy-exp__details surface">
						<p class="eyebrow">
							<LocaleText as="span" text={primary.role} />
						</p>
						<h3>{primary.company}</h3>
						<p class="period">
							<LocaleText as="span" text={primary.period} />
						</p>
						<p>
							<LocaleText as="span" text={primary.summary} />
						</p>
						{primary.achievements && primary.achievements.length > 0 && (
							<div class="mt-4 relative">
								<input type="checkbox" id={`toggle-${primary.company.replace(/\\s+/g, '-')}`} class="legacy-exp__toggle hidden" />
								<div class="legacy-exp__collapse overflow-hidden max-h-[140px] transition-[max-height] duration-500 ease-in-out relative">
									<ul class="mt-3">
										{primary.achievements.map((item) => (
											<li class="mb-2">
												<LocaleText as="span" text={item} />
											</li>
										))}
									</ul>
									<div class="legacy-exp__fade absolute bottom-0 left-0 w-full h-16 bg-gradient-to-t from-[var(--bg-soft)] to-transparent transition-opacity duration-300 pointer-events-none"></div>
								</div>
								<label for={`toggle-${primary.company.replace(/\\s+/g, '-')}`} class="legacy-exp__label cursor-pointer text-base font-semibold text-accent hover:underline mt-2 inline-flex items-center select-none">
									<span class="read-more">Read details</span>
									<span class="show-less">Show less</span>
								</label>
							</div>
						)}
					</div>
				</div>

				{secondary.length > 0 && (
					<div class="legacy-exp__list">
						{secondary.map((exp) => (
							<article class="surface">
								<header>
									{exp.logo ? (
										<div class="legacy-exp__badge legacy-exp__badge--image">
											<img src={exp.logo} alt={exp.company} loading="lazy" />
										</div>
									) : (
										<div class="legacy-exp__badge">{exp.company.slice(0, 2).toUpperCase()}</div>
									)}
									<div>
										<h4>{exp.company}</h4>
										<p class="eyebrow text-xs" style="margin: 0.15rem 0;">
											<LocaleText as="span" text={exp.role} />
										</p>
										<p class="period" style="margin-top: 0;">
											<LocaleText as="span" text={exp.period} />
										</p>
									</div>
								</header>
								<p class="text-sm">
									<LocaleText as="span" text={exp.summary} />
								</p>
								{exp.achievements && exp.achievements.length > 0 && (
									<div class="mt-3 relative">
										<input type="checkbox" id={`toggle-sec-${exp.company.replace(/\\s+/g, '-')}`} class="legacy-exp__toggle hidden" />
										<div class="legacy-exp__collapse overflow-hidden max-h-[100px] transition-[max-height] duration-500 ease-in-out relative">
											<ul class="mt-2 text-sm pl-4">
												{exp.achievements.map((item) => (
													<li class="mb-1">
														<LocaleText as="span" text={item} />
													</li>
												))}
											</ul>
											<div class="legacy-exp__fade absolute bottom-0 left-0 w-full h-12 bg-gradient-to-t from-[var(--bg-soft)] to-transparent transition-opacity duration-300 pointer-events-none"></div>
										</div>
										<label for={`toggle-sec-${exp.company.replace(/\\s+/g, '-')}`} class="legacy-exp__label cursor-pointer text-sm font-semibold text-accent hover:underline mt-2 inline-flex items-center select-none">
											<span class="read-more">Read details</span>
											<span class="show-less">Show less</span>
										</label>
									</div>
								)}
							</article>
						))}
					</div>
				)}
			</div>
		);
	})}
</section>

<style>
	.legacy-exp__toggle:checked ~ .legacy-exp__label .read-more {
		display: none;
	}
	.legacy-exp__toggle:not(:checked) ~ .legacy-exp__label .show-less {
		display: none;
	}
	.legacy-exp__toggle:checked ~ .legacy-exp__collapse {
		max-height: 3000px;
	}
	.legacy-exp__toggle:checked ~ .legacy-exp__collapse .legacy-exp__fade {
		opacity: 0;
	}

	.legacy-exp {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.legacy-exp__group {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.legacy-exp__intro h2 {
		margin: 0 0 0.5rem;
		font-family: inherit;
		font-size: clamp(1.75rem, 3.5vw, 2.25rem);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--text);
	}

	.legacy-exp__content {
		display: grid;
		grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
		gap: 1.5rem;
		align-items: stretch;
	}

	.legacy-exp__media {
		border-radius: 12px;
		background: var(--bg-soft);
		border: 1px solid var(--border);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem;
	}

	.badge {
		color: var(--text);
		font-weight: 600;
		text-align: center;
		font-size: 1.1rem;
		line-height: 1.4;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.badge--image {
		border-radius: 12px;
		padding: 1rem 1.25rem;
	}

	.badge--image img {
		max-height: 200px;
		width: auto;
		display: block;
		border-radius: 8px;
	}

	.legacy-exp__details h3 {
		margin: 0 0 0.25rem;
		font-family: inherit;
		font-size: 1.15rem;
	}

	.legacy-exp__details > p:not(.period):not(.eyebrow) {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--muted);
	}

	.period {
		margin: 0 0 1rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--muted);
	}

	.legacy-exp__details ul {
		margin: 1rem 0 0;
		padding-left: 1.5rem;
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.legacy-exp__list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1rem;
	}

	.legacy-exp__list h4 {
		margin: 0;
		font-family: inherit;
		font-size: 1.15rem;
	}

	.legacy-exp__list p.text-sm {
		margin: 0.5rem 0 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--muted);
	}

	.legacy-exp__list ul {
		margin: 1rem 0 0;
		padding-left: 1.5rem;
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.legacy-exp__list header {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 0.75rem;
	}

	.legacy-exp__badge {
		width: 46px;
		height: 46px;
		border-radius: 12px;
		display: grid;
		place-items: center;
		font-weight: 700;
		color: var(--text);
		background: var(--bg);
		border: 1px solid var(--border);
		font-size: 0.9rem;
		text-align: center;
		padding: 0.25rem;
	}

	.legacy-exp__badge--image {
		background: var(--bg-soft);
	}

	.legacy-exp__badge--image img {
		max-height: 40px;
		width: auto;
		display: block;
		border-radius: 6px;
	}

	@media (max-width: 960px) {
		.legacy-exp__content {
			grid-template-columns: 1fr;
		}
	}
</style>
