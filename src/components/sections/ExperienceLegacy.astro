---
import type { Experience } from '../../types/profile.types';
import LocaleText from '../i18n/LocaleText.astro';

type Props = {
	experiences: Experience[];
};

const { experiences }: Props = Astro.props;
const primary = experiences[0];
const secondary = experiences.slice(1);
---

<section id="experience" class="section legacy-exp">
	<div class="legacy-exp__content">
		<div class="legacy-exp__media">
			{primary.logo ? (
				<div class="badge badge--image">
					<img src={primary.logo} alt={primary.company} loading="lazy" />
				</div>
			) : (
				<div class="badge">
					<span>{primary.company}</span>
				</div>
			)}
		</div>
		<div class="legacy-exp__details surface">
			<p class="eyebrow">
				<LocaleText as="span" text={primary.role} />
			</p>
			<h3>{primary.company}</h3>
			<p class="period">{primary.period}</p>
			<p>
				<LocaleText as="span" text={primary.summary} />
			</p>
			<ul>
				{primary.achievements.map((item) => (
					<li>
						<LocaleText as="span" text={item} />
					</li>
				))}
			</ul>
		</div>
	</div>
	{secondary.length > 0 && (
		<div class="legacy-exp__list">
			{secondary.map((exp) => (
				<article class="surface">
					<header>
						{exp.logo ? (
							<div class="legacy-exp__badge legacy-exp__badge--image">
								<img src={exp.logo} alt={exp.company} loading="lazy" />
							</div>
						) : (
							<div class="legacy-exp__badge">{exp.company.slice(0, 2).toUpperCase()}</div>
						)}
						<div>
							<h4>{exp.company}</h4>
							<p class="period">{exp.period}</p>
						</div>
					</header>
					<p>
						<LocaleText as="span" text={exp.summary} />
					</p>
					<ul>
						{exp.achievements.map((item) => (
							<li>
								<LocaleText as="span" text={item} />
							</li>
						))}
					</ul>
				</article>
			))}
		</div>
	)}
</section>

<style>
	.legacy-exp__content {
		display: grid;
		grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
		gap: 1.25rem;
		align-items: stretch;
		margin-bottom: 2rem;
	}

	.legacy-exp__media {
		border-radius: 1.5rem;
		background: linear-gradient(135deg, #1d4ed8, #38bdf8);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem;
	}

	.badge {
		color: #ffffff;
		font-weight: 600;
		text-align: center;
		font-size: 1.1rem;
		line-height: 1.4;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.badge--image {
		background: rgba(255, 255, 255, 0.08);
		border-radius: 1rem;
		padding: 0.75rem 1rem;
	}

	.badge--image img {
		max-height: 60px;
		width: auto;
		display: block;
	}

	.legacy-exp__details h3 {
		margin: 0 0 0.25rem;
		font-size: 1.5rem;
	}

	.period {
		margin: 0 0 1rem;
		font-weight: 600;
		color: var(--muted);
	}

	.legacy-exp__details ul {
		margin: 1rem 0 0;
		padding-left: 1.2rem;
		color: var(--muted);
	}

	.legacy-exp__list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1rem;
	}

	.legacy-exp__list h4 {
		margin: 0;
	}

	.legacy-exp__list ul {
		margin: 0.75rem 0 0;
		padding-left: 1.2rem;
		color: var(--muted);
	}

	.legacy-exp__list header {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 0.6rem;
	}

	.legacy-exp__badge {
		width: 46px;
		height: 46px;
		border-radius: 14px;
		display: grid;
		place-items: center;
		font-weight: 700;
		color: #0f172a;
		background: linear-gradient(135deg, #c7d2fe, #a5b4fc, #c7d2fe);
		border: 1px solid var(--border);
		font-size: 0.9rem;
		text-align: center;
		padding: 0.3rem;
	}

	.legacy-exp__badge--image {
		background: var(--bg-elevated);
	}

	.legacy-exp__badge--image img {
		max-height: 40px;
		width: auto;
		display: block;
	}

	@media (max-width: 960px) {
		.legacy-exp__content {
			grid-template-columns: 1fr;
		}
	}
</style>
