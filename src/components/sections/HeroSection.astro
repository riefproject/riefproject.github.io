---
import type {
	Contact,
	Highlight,
	Profile,
	SocialLink,
	Stat,
} from '../../types/profile.types';
import LocaleText from '../i18n/LocaleText.astro';

const locale = (en: string, id: string) => ({ en, id });

type HeroProps = {
	profile: Profile;
	contact: Contact;
	highlights: Highlight[];
	stats: Stat[];
	socials: SocialLink[];
	toolbox: string[];
};

const { profile, contact, highlights, stats, socials, toolbox }: HeroProps = Astro.props as HeroProps;

const heroCopy = {
	greeting: locale('Hi, I’m', 'Hai, saya'),
	viewProjects: locale('See selected work', 'Lihat proyek pilihan'),
	contact: locale('Contact me', 'Hubungi saya'),
	availabilityTitle: locale('Availability', 'Ketersediaan'),
	downloadCv: locale('Download CV', 'Unduh CV'),
	snapshot: {
		role: locale('Role', 'Peran'),
		location: locale('Location', 'Lokasi'),
		availability: locale('Availability', 'Ketersediaan'),
	},
};

const initials = profile.name
	.split(' ')
	.filter(Boolean)
	.map((part) => part[0])
	.slice(0, 2)
	.join('')
	.toUpperCase();

const toolboxPreview = toolbox.slice(0, 6);
const extraTools = Math.max(toolbox.length - toolboxPreview.length, 0);
---

<section id="beranda" class="section hero">
	<div class="hero__content surface">
		<div class="hero__header">
			<p class="eyebrow">
				<LocaleText as="span" text={heroCopy.greeting} /> {profile.name}
			</p>
			<div class="hero__monogram" aria-hidden="true">{initials}</div>
		</div>
		<h1>
			<LocaleText as="span" text={profile.role} />
			<span>
				<LocaleText as="span" text={profile.tagline} />
			</span>
		</h1>
		<p class="hero__location">
			<LocaleText as="span" text={profile.location} />
		</p>
		<p class="lead">
			<LocaleText as="span" text={profile.intro} />
		</p>
		<p class="hero__stack">
			<LocaleText as="span" text={profile.focusStack} />
		</p>
		<div class="hero__cta">
			<a class="btn primary" href="#proyek">
				<LocaleText as="span" text={heroCopy.viewProjects} />
			</a>
			<a class="btn ghost" href={`mailto:${contact.email}`}>
				<LocaleText as="span" text={heroCopy.contact} />
			</a>
			{profile.resumeUrl && (
				<a class="btn ghost" href={profile.resumeUrl} target="_blank" rel="noreferrer">
					<LocaleText as="span" text={heroCopy.downloadCv} />
				</a>
			)}
		</div>
		{toolboxPreview.length > 0 && (
			<div class="hero__toolbox" aria-label="Toolbox highlight">
				{toolboxPreview.map((item) => (
					<span class="hero__tool hover-scale">{item}</span>
				))}
				{extraTools > 0 && <span class="hero__tool ghost hover-scale">+{extraTools} more</span>}
			</div>
		)}
		<ul class="hero__highlights">
			{highlights.map((item) => (
				<li class="card-hover">
					<span><LocaleText as="span" text={item.label} /></span>
					<strong><LocaleText as="span" text={item.detail} /></strong>
				</li>
			))}
		</ul>
	</div>
	<div class="hero__meta grid">
		<div class="surface hero__stats">
			{stats.map((stat) => (
				<div>
					<strong>{stat.value}</strong>
					<p>
						<LocaleText as="span" text={stat.label} />
					</p>
					{stat.helper && (
						<small>
							<LocaleText as="span" text={stat.helper} />
						</small>
					)}
				</div>
			))}
		</div>
		<div class="surface hero__availability">
			<p class="eyebrow">
				<LocaleText as="span" text={heroCopy.availabilityTitle} />
			</p>
			<strong>
				<LocaleText as="span" text={profile.availability} />
			</strong>
			<p>
				<LocaleText as="span" text={contact.availabilityNote} />
			</p>
			<div class="social-list">
				{socials.map((social) => (
					<a href={social.url} target="_blank" rel="noreferrer">
						{social.label}
					</a>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		gap: 1.5rem;
		align-items: start;
		position: relative;
		isolation: isolate;
	}

	.hero__content h1 {
		font-size: clamp(2.9rem, 6svw, 3.9rem);
		margin: 0 0 0.75rem;
		line-height: 1.05;
	}

	.hero__content {
		display: grid;
		gap: 0.75rem;
		align-content: start;
	}

	.hero .surface {
		box-shadow: none;
	}

	.hero__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.hero__monogram {
		width: 3rem;
		height: 3rem;
		border-radius: 0.9rem;
		background: linear-gradient(135deg, rgba(14, 165, 233, 0.28), rgba(34, 197, 94, 0.18));
		border: 1px solid rgba(14, 165, 233, 0.35);
		display: grid;
		place-items: center;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--text);
		animation: float 6s ease-in-out infinite;
	}

	@keyframes float {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-6px); }
	}

	.hero__content h1 span {
		display: block;
		color: var(--accent);
		font-size: 1.1rem;
		margin-top: 0.35rem;
	}

	.hero__snapshot {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 0.75rem;
		padding: 0;
		margin: 0.25rem 0 0.5rem;
	}

	.hero__snapshot li {
		padding: 0.75rem 0.9rem;
		border: 1px solid rgba(14, 165, 233, 0.18);
		border-radius: 1rem;
		background: rgba(14, 165, 233, 0.05);
		display: grid;
		gap: 0.25rem;
	}

	.hero__snapshot span {
		font-size: 0.75rem;
		color: var(--muted);
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.hero__snapshot strong {
		font-size: 0.98rem;
		color: var(--text);
		line-height: 1.3;
	}

	.hero__location {
		color: var(--muted);
		margin: 0 0 1rem;
		font-size: 0.95rem;
	}

	.lead {
		font-size: 1.05rem;
		margin-bottom: 1rem;
		color: var(--muted);
	}

	.hero__stack {
		margin: 0 0 1.25rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		font-size: 0.85rem;
		color: var(--accent-strong);
	}

	.hero__toolbox {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 1.25rem;
	}

	.hero__tool {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		border: 1px solid rgba(14, 165, 233, 0.35);
		background: linear-gradient(120deg, rgba(14, 165, 233, 0.12), rgba(14, 165, 233, 0.06));
		font-weight: 600;
		font-size: 0.85rem;
		color: var(--text);
	}

	.hero__tool::before {
		content: '•';
		color: var(--accent-strong);
		font-size: 1rem;
		line-height: 1;
	}

	.hero__tool.ghost {
		background: rgba(14, 165, 233, 0.06);
		border-style: dashed;
		color: var(--muted);
	}

	.hero__cta {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 1.5rem;
	}

	.hero__highlights {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 1rem;
		padding: 0;
		margin: 0;
	}

	.hero__highlights li {
		padding: 0.75rem 1rem;
		border-radius: 1rem;
		border: 1px solid rgba(14, 165, 233, 0.16);
		background: linear-gradient(130deg, rgba(14, 165, 233, 0.08), rgba(14, 165, 233, 0.03));
	}

	.hero__highlights span {
		display: block;
		font-size: 0.8rem;
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 0.35rem;
	}

	.hero__highlights strong {
		font-size: 1rem;
		color: var(--text);
	}

	.hero__meta {
		align-content: start;
		grid-template-columns: 1fr;
		gap: 1rem;
		max-width: 460px;
		margin-left: auto;
	}

	.hero__availability strong {
		display: block;
		font-size: 1.1rem;
		margin-bottom: 0.5rem;
	}

	.hero__stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 1rem;
		text-align: left;
	}

	.hero__stats strong {
		font-size: 2rem;
		color: var(--text);
	}

	.hero__stats small {
		color: var(--muted);
		font-size: 0.85rem;
	}

	@media (max-width: 960px) {
		.hero {
			grid-template-columns: 1fr;
		}
	}

	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background: none;
	}
</style>
