---
import type {
	Contact,
	Highlight,
	Profile,
	SocialLink,
	Stat,
} from '../../types/profile.types';
import LocaleText from '../i18n/LocaleText.astro';
import CvDownloadButton from '../CvDownloadButton.vue';

const locale = (en: string, id: string) => ({ en, id });

type HeroProps = {
	profile: Profile;
	contact: Contact;
	highlights: Highlight[];
	stats: Stat[];
	socials: SocialLink[];
	toolbox: string[];
};

const { profile, contact, highlights, stats, socials, toolbox }: HeroProps = Astro.props as HeroProps;

const heroCopy = {
	greeting: locale('Hi, I’m', 'Hai, saya'),
	viewProjects: locale('View Projects', 'Lihat Proyek'),
	contact: locale('Contact Me', 'Hubungi Saya'),
	availabilityTitle: locale('Current Status', 'Status Saat Ini'),
	downloadCv: locale('Download CV', 'Unduh CV'),
};

const toolboxPreview = toolbox.slice(0, 7);
const extraTools = Math.max(toolbox.length - toolboxPreview.length, 0);
---

<section id="beranda" class="section hero-bento">
  
	<!-- 1. Main Profile Block (Hero) -->
	<div class="bento-card bento-main">
		<div class="hero__header">
      <div class="status-badge">
        <span class="ping"></span>
        <span class="status-text"><LocaleText as="span" text={profile.availability} /></span>
      </div>
		</div>
		<h1 class="font-display">
			<LocaleText as="span" text={profile.role} />
			<span class="text-muted block mt-2 font-normal text-2xl">
				<LocaleText as="span" text={profile.tagline} />
			</span>
		</h1>
		<p class="lead">
			<LocaleText as="span" text={profile.intro} />
		</p>
		
		<div class="hero__cta mt-auto pt-6 border-t border-border/50">
			<a class="btn primary" href="#proyek">
				<LocaleText as="span" text={heroCopy.viewProjects} />
			</a>
			<a class="btn ghost" href={`mailto:${contact.email}`}>
				<LocaleText as="span" text={heroCopy.contact} />
			</a>
		</div>
	</div>

  <!-- 2. Quick Stats Grid -->
  <div class="bento-card bento-stats">
    <div class="stats-grid">
      {stats.map((stat) => (
        <div class="stat-item">
          <strong class="font-mono text-text">{stat.value}</strong>
          <p class="text-sm text-muted mt-1">
            <LocaleText as="span" text={stat.label} />
          </p>
        </div>
      ))}
    </div>
  </div>

  <!-- 3. Tech Stack / Toolbox -->
  <div class="bento-card bento-toolbox">
    <p class="eyebrow mb-4"><LocaleText as="span" text={profile.focusStack} /></p>
    <div class="hero__toolbox">
      {toolboxPreview.map((item) => (
        <span class="hero__tool">{item}</span>
      ))}
      {extraTools > 0 && <span class="hero__tool ghost">+{extraTools}</span>}
    </div>
  </div>

  <!-- 4. Highlights / Focus Areas -->
  <div class="bento-card bento-highlights">
    <ul class="highlights-list">
      {highlights.map((item) => (
        <li>
          <span class="text-xs uppercase tracking-wider text-muted font-semibold"><LocaleText as="span" text={item.label} /></span>
          <strong class="block mt-1 font-medium text-text"><LocaleText as="span" text={item.detail} /></strong>
        </li>
      ))}
    </ul>
  </div>

  <!-- 5. Social & Contact Connect -->
  <div class="bento-card bento-socials">
    <p class="eyebrow mb-4">Connect</p>
    <p class="text-sm text-muted mb-6"><LocaleText as="span" text={contact.availabilityNote} /></p>
    <div class="social-list mt-auto">
      {socials.map((social) => (
        <a href={social.url} target="_blank" rel="noreferrer" class="social-btn">
          {social.label}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1 opacity-50 group-hover:opacity-100 transition-opacity"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
        </a>
      ))}
    </div>
  </div>

</section>

<style>
	/* ── Layout: clean 2-column (content left, meta right) ── */
	.hero-bento {
		display: grid;
		grid-template-columns: 7fr 5fr;
		gap: 1.5rem;
		align-items: start;
		padding: 4rem 0 3rem;
	}

	/* ── Cards ── */
	.bento-card {
		background: var(--bg-soft);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 2rem;
		display: flex;
		flex-direction: column;
		transition: border-color 0.2s ease;
	}

	.bento-card:hover {
		border-color: var(--muted);
	}

	/* Grid placement — left column */
	.bento-main {
		grid-column: 1;
		grid-row: 1 / 3;
	}

	/* Grid placement — right column */
	.bento-stats {
		grid-column: 2;
		justify-content: center;
	}

	.bento-toolbox {
		grid-column: 2;
	}

	/* Full-width row below */
	.bento-highlights {
		grid-column: 1 / -1;
	}

	.bento-socials {
		grid-column: 1 / -1;
	}

	/* ── Status Badge: simple green pill ── */
	.hero__header {
		margin-bottom: 2rem;
	}

	.status-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.3rem 0.85rem;
		border-radius: 999px;
		background: var(--bg);
		border: 1px solid var(--border);
	}

	.ping {
		width: 7px;
		height: 7px;
		background: #22c55e;
		border-radius: 50%;
	}

	.status-text {
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--muted);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	/* ── Typography ── */
	.bento-main h1 {
		font-family: inherit;
		font-size: clamp(2.25rem, 4vw, 3.25rem);
		margin: 0 0 1.5rem;
		line-height: 1.15;
		color: var(--text);
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.lead {
		font-size: 1.05rem;
		color: var(--muted);
		line-height: 1.7;
		max-width: 90%;
		margin-bottom: 2rem;
	}

	/* ── Buttons ── */
	.hero__cta {
		display: flex;
		gap: 0.75rem;
		align-items: center;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.6rem 1.35rem;
		border-radius: 8px;
		font-weight: 500;
		font-size: 0.95rem;
		transition: opacity 0.2s ease;
		text-decoration: none;
		cursor: pointer;
	}

	.btn.primary {
		background: var(--accent);
		color: #fff;
	}

	.btn.primary:hover {
		opacity: 0.85;
	}

	.btn.ghost {
		background: transparent;
		color: var(--text);
		border: 1px solid var(--border);
	}

	.btn.ghost:hover {
		border-color: var(--muted);
	}

	/* ── Stats ── */
	.stats-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	.stat-item strong {
		font-family: inherit;
		font-size: 2rem;
		line-height: 1;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--text);
	}

	/* ── Toolbox ── */
	.eyebrow {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
		font-weight: 600;
	}

	.hero__toolbox {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.hero__tool {
		padding: 0.3rem 0.7rem;
		border-radius: 6px;
		background: var(--bg);
		border: 1px solid var(--border);
		color: var(--text);
		font-size: 0.85rem;
	}

	.hero__tool.ghost {
		background: transparent;
		color: var(--muted);
		border-style: dashed;
	}

	/* ── Highlights ── */
	.highlights-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}

	.highlights-list li {
		padding-left: 1rem;
		border-left: 2px solid var(--border);
	}

	/* ── Socials ── */
	.social-list {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.social-btn {
		display: inline-flex;
		align-items: center;
		color: var(--text);
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
		transition: color 0.2s ease;
	}

	.social-btn:hover {
		color: var(--accent);
	}

	/* ── Responsive ── */
	@media (max-width: 1024px) {
		.hero-bento {
			grid-template-columns: 1fr;
		}
		.bento-main,
		.bento-stats,
		.bento-toolbox,
		.bento-highlights,
		.bento-socials {
			grid-column: 1;
		}
		.bento-main {
			grid-row: auto;
		}
	}

	@media (max-width: 768px) {
		.highlights-list {
			grid-template-columns: 1fr;
		}
		.stats-grid {
			gap: 1rem;
		}
	}

	@media (max-width: 640px) {
		.hero__cta {
			flex-direction: column;
			align-items: stretch;
		}
		.btn {
			text-align: center;
			justify-content: center;
		}
	}
</style>
