---
import type { Project } from '../../types/profile.types';
import ProjectGallery from '../projects/ProjectGallery.vue';
import LocaleText from '../i18n/LocaleText.astro';

const locale = (en: string, id: string) => ({ en, id });

type ProjectsProps = {
	projects?: Project[];
};

const { projects = [] }: ProjectsProps = Astro.props;
const categoryMap = new Map<string, Project['category']>();
projects.forEach((project) => {
	if (!categoryMap.has(project.categoryKey)) {
		categoryMap.set(project.categoryKey, project.category);
	}
});
const categories = [
	{ key: 'all', label: locale('All', 'Semua') },
	...Array.from(categoryMap.entries()).map(([key, label]) => ({ key, label })),
];

const copy = {
	eyebrow: locale('Selected projects', 'Proyek pilihan'),
	heading: locale('Recent builds and experiments I enjoyed shipping.', 'Build dan eksperimen terbaru yang paling saya nikmati.'),
	body: locale(
		'I start from a clear problem, ship quickly, and iterate. Here are a few highlights.',
		'Berawal dari masalah yang jelas, dieksekusi cepat, lalu iterasi. Berikut beberapa sorotan.',
	),
};
---

<section id="proyek" class="section projects">
	<div class="surface projects__intro">
		<p class="eyebrow">
			<LocaleText as="span" text={copy.eyebrow} />
		</p>
		<h2>
			<LocaleText as="span" text={copy.heading} />
		</h2>
		<p>
			<LocaleText as="span" text={copy.body} />
		</p>
	</div>
	<ProjectGallery client:load projects={projects} categories={categories} />
</section>

<style>
	.projects {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.projects__intro h2 {
		margin: 0 0 0.5rem;
		font-size: clamp(2rem, 4svw, 2.4rem);
	}
</style>
