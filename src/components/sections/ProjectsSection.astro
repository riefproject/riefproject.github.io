---
import type { Project } from '../../types/profile.types'
import LocaleText from '../i18n/LocaleText.astro'
import SectionIntro from './SectionIntro.astro'
import FeaturedProjects from '../projects/FeaturedProjects.vue'
import { t as locale } from '../../utils/i18n'

type ProjectsProps = {
  projects?: Project[]
}

const { projects = [] }: ProjectsProps = Astro.props

// Get only featured projects (max 3)
const featuredProjects = projects.filter((p) => p.featured).slice(0, 3)

const copy = {
  eyebrow: locale('Featured projects', 'Proyek unggulan'),
  heading: locale(
    'Recent builds and experiments I enjoyed shipping.',
    'Build dan eksperimen terbaru yang paling saya nikmati.'
  ),
  body: locale(
    'I start from a clear problem, ship quickly, and iterate. Here are my top projects.',
    'Berawal dari masalah yang jelas, dieksekusi cepat, lalu iterasi. Berikut proyek terbaik saya.'
  ),
  viewAll: locale('View All Projects', 'Lihat Semua Proyek'),
}
---

<section id="proyek" class="section projects">
  <SectionIntro
    class="projects__intro"
    eyebrow={copy.eyebrow}
    heading={copy.heading}
    body={copy.body}
  />

  <FeaturedProjects client:visible projects={featuredProjects} />

  <div class="projects-cta">
    <a href="/projects" class="cta-link">
      <LocaleText as="span" text={copy.viewAll} />
      <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M17 8l4 4m0 0l-4 4m4-4H3"
        />
      </svg>
    </a>
  </div>
</section>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .projects :global(.projects__intro) {
    margin-bottom: 0;
  }

  .projects-cta {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--accent);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .cta-link:hover {
    background: var(--accent);
    color: white;
  }

  .cta-link svg {
    transition: transform 0.2s ease;
  }

  .cta-link:hover svg {
    transform: translateX(4px);
  }
</style>
