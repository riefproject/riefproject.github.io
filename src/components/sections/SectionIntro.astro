---
import type { LocaleText } from '../../types/profile.types';
import LocaleText from '../i18n/LocaleText.astro';

export type SectionIntroProps = {
  eyebrow: LocaleText;
  heading: LocaleText;
  body?: LocaleText;
  class?: string;
  surface?: boolean;
};

const {
  eyebrow,
  heading,
  body,
  class: className = '',
  surface = true,
} = Astro.props as SectionIntroProps;
---

<div class:list={['section-intro', surface && 'surface', className]}>
  <p class="eyebrow">
    <LocaleText as="span" text={eyebrow} />
  </p>
  <h2>
    <LocaleText as="span" text={heading} />
  </h2>
  {body && (
    <p>
      <LocaleText as="span" text={body} />
    </p>
  )}
  <slot />
</div>
