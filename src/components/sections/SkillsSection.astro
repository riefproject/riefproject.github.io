---
import type { SkillCategory } from '../../types/profile.types';
import LocaleText from '../i18n/LocaleText.astro';

const locale = (en: string, id: string) => ({ en, id });
const copy = {
	eyebrow: locale('Technical Skills', 'Keahlian Teknis'),
	heading: locale('Full-stack development with strong algorithmic foundation.', 'Pengembangan full-stack dengan fondasi algoritma yang kuat.'),
	intro: locale(
		'Building enterprise applications and solving complex problems through systematic software engineering practices.',
		'Membangun aplikasi enterprise dan menyelesaikan masalah kompleks melalui praktik rekayasa perangkat lunak sistematis.',
	),
};

type SkillsProps = {
	categories?: SkillCategory[];
};

const { categories = [] }: SkillsProps = Astro.props;
---

<section id="skills" class="section skills">
	<div class="skills__intro surface">
		<p class="eyebrow">
			<LocaleText as="span" text={copy.eyebrow} />
		</p>
		<h2>
			<LocaleText as="span" text={copy.heading} />
		</h2>
		<p>
			<LocaleText as="span" text={copy.intro} />
		</p>
	</div>
	<div class="skills__grid">
		{categories.map((category) => (
			<article class="surface">
				<header>
					<h3>
						<LocaleText as="span" text={category.title} />
					</h3>
					{category.helper && (
						<small>
							<LocaleText as="span" text={category.helper} />
						</small>
					)}
				</header>
				<ul>
					{category.items.map((item) => (
						<li>
							<LocaleText as="span" text={item} />
						</li>
					))}
				</ul>
			</article>
		))}
	</div>
</section>

<style>
	.skills {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.skills__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1rem;
	}

	.skills__grid article h3 {
		margin: 0;
		font-size: 1.1rem;
		font-family: inherit;
	}

	.skills__grid article small {
		color: var(--muted);
	}

	.skills__grid ul {
		margin: 0.75rem 0 0;
		padding-left: 1rem;
		color: var(--muted);
	}

	.skills__grid li + li {
		margin-top: 0.25rem;
	}

	.skills__grid li {
		transition: color 0.2s ease;
	}

	.skills__grid li:hover {
		color: var(--accent);
	}
</style>
