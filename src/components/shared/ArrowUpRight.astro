---
type Props = {
  class?: string;
  size?: number;
};

const { class: className = '', size = 12 } = Astro.props as Props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  <path d="M7 17l9.2-9.2M17 17V7H7"></path>
</svg>
