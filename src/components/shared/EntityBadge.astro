---
export type EntityBadgeProps = {
  logo?: string
  logoLight?: string
  name: string
  fallbackText?: string
  initialsLength?: number
  size?: number
  fontSize?: string
  boxed?: boolean
  class?: string
}

const {
  logo,
  logoLight,
  name,
  fallbackText,
  initialsLength = 2,
  size = 40,
  fontSize = '0.9rem',
  boxed = false,
  class: className = '',
} = Astro.props as EntityBadgeProps

const fallback = fallbackText ?? name.slice(0, initialsLength).toUpperCase()
---

<span
  class:list={['entity-badge', boxed && 'entity-badge--boxed', className]}
  style={`--entity-badge-size: ${size}px; font-size: ${fontSize};`}>
  {logo && logoLight ?
    <>
      <img
        src={logo}
        alt={name}
        width={size}
        height={size}
        loading="lazy"
        decoding="async"
        class="logo-variant-dark"
      />
      <img
        src={logoLight}
        alt={name}
        width={size}
        height={size}
        loading="lazy"
        decoding="async"
        class="logo-variant-light"
      />
    </>
  : logo ?
    <img src={logo} alt={name} width={size} height={size} loading="lazy" decoding="async" />
  : <span>{fallback}</span>}
</span>
