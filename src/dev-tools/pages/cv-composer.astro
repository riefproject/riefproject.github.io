---
export const prerender = false;

import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import CvComposer from '../components/cv/CvComposer.vue';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const cvDir = path.resolve(__dirname, '../data/cv');

const lang = Astro.url.searchParams.get('lang') || 'id';
const htmlFileName = lang === 'en' ? 'source-en.html' : 'source-id.html';

const htmlPath = path.join(cvDir, htmlFileName);
const cssPath = path.join(cvDir, 'source.css');

// Fallback to source.html if the specific language one doesn't exist yet
let initialHtml = null;
if (fs.existsSync(htmlPath)) {
  initialHtml = fs.readFileSync(htmlPath, 'utf-8');
} else if (fs.existsSync(path.join(cvDir, 'source.html'))) {
  initialHtml = fs.readFileSync(path.join(cvDir, 'source.html'), 'utf-8');
}

const initialCss = fs.existsSync(cssPath) ? fs.readFileSync(cssPath, 'utf-8') : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CV Visual Composer</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
    }
  </style>
</head>
<body>
  <CvComposer client:only="vue" initialHtml={initialHtml} initialCss={initialCss} lang={lang} />
</body>
</html>
