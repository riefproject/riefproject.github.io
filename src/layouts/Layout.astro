---
import '../styles/global.css';
import { contact } from '../data/contact';
import { profile } from '../data/profile';
import ThemeToggle from '../components/ThemeToggle.vue';
import LangToggle from '../components/LangToggle.vue';
import CvDownloadButton from '../components/CvDownloadButton.vue';
import LocaleText from '../components/i18n/LocaleText.astro';

type LayoutProps = {
	title?: string;
	description?: string;
};

const locale = (en: string, id: string) => ({ en, id });

const navItems = [
	{ label: locale('Home', 'Beranda'), href: '#beranda' },
	{ label: locale('About', 'Tentang'), href: '#tentang' },
	{ label: locale('Skills', 'Keahlian'), href: '#skills' },
	{ label: locale('Experience', 'Pengalaman'), href: '#experience' },
	{ label: locale('Projects', 'Proyek'), href: '#proyek' },
	{ label: locale('Achievements', 'Pencapaian'), href: '#achievements' },
	{ label: locale('Education', 'Pendidikan'), href: '#education' },
	{ label: locale('Contact', 'Kontak'), href: '#kontak' },
].map((item) => ({
	...item,
	id: item.href.replace('#', ''),
	to: `/#${item.href.replace('#', '')}`,
}));

const SITE_URL = "https://riefproject.my.id";

const layoutCopy = {
	skip: locale('Skip to content', 'Lewati ke konten'),
	menu: locale('Menu', 'Menu'),
	menuInfo: locale('navigation', 'navigasi'),
	close: locale('Close menu', 'Tutup menu'),
	explore: locale('Explore work', 'Explore karya'),
	cta: locale('Submit a project', 'Ajukan proyek'),
	downloadCv: locale('Download CV', 'Unduh CV'),
	footerThanks: locale('Thanks for stopping by', 'Terima kasih sudah mampir'),
	footerBuilt: locale('Built with Astro · Vue · Tailwind', 'Dibuat dengan Astro · Vue · Tailwind'),
};

const {
	title = `${profile.name} — Software Engineer & Competitive Programmer`,
	description = profile.intro.en,
}: LayoutProps = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Hi Res Favicon -->
		<link rel="icon" type="image/png" sizes="972x972" href="/favicon.png" />
		<!-- Google Search Favicon -->
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
		<link rel="icon" type="image/png" sizes="144x144" href="/favicon-144.png" />
		<!-- Apple / iOS -->
		<link rel="apple-touch-icon" href="/apple-touch-icon.png">
		
		<!-- Google Fonts (Non-blocking) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" media="print" onload="this.media='all'" />
		<noscript>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
		</noscript>

		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="canonical" href={Astro.url} />
		<meta name="robots" content="index, follow" />
		<script
			defer
			data-domain="riefproject.my.id"
			src="https://plausible.io/js/script.js"
		></script>
		<meta name="generator" content={Astro.generator} />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content={profile.name} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={`${SITE_URL}/og-image.jpg`} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={Astro.url} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${SITE_URL}/og-image.jpg`} />


		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Person",
				"name": "Arief F-sa Wijaya",
				"url": "https://riefproject.my.id",
				"jobTitle": "Software Engineer & Competitive Programmer",
				"sameAs": [
					"https://github.com/riefproject",
					"https://www.linkedin.com/in/arieffsawijaya"
				]
			}
		</script>


		<script is:inline>
			(() => {
				const storageKey = 'portfolio-theme';
				let initial = 'light';
				try {
					const stored = typeof localStorage !== 'undefined' ? localStorage.getItem(storageKey) : null;
					if (stored) {
						initial = stored;
					} else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
						initial = 'dark';
					}
				} catch (err) {
					initial = 'light';
				}
				if (initial === 'dark') {
					document.documentElement.classList.add('dark');
					document.documentElement.classList.remove('light');
				} else {
					document.documentElement.classList.add('light');
					document.documentElement.classList.remove('dark');
				}
			})();
		</script>
			<script is:inline>
				(() => {
					const storageKey = 'portfolio-lang';
					const normalizeLang = (value) => {
						if (typeof value !== 'string') return 'en';
						const normalized = value.toLowerCase();
						if (normalized === 'id' || normalized === 'in' || normalized.startsWith('id-')) {
							return 'id';
						}
						return 'en';
					};
					const persistLang = (lang) => {
						try {
							if (typeof localStorage !== 'undefined') {
								localStorage.setItem(storageKey, lang);
							}
						} catch (err) {
							// ignore storage write failure
						}
					};

					const applyLanguage = (rawLang) => {
						const lang = normalizeLang(rawLang);
						const root = document.documentElement;
						root.classList.toggle('lang-id', lang === 'id');
							root.classList.toggle('lang-en', lang !== 'id');
							root.setAttribute('lang', lang === 'id' ? 'id' : 'en');
							const attribute = lang === 'id' ? 'data-i18n-id' : 'data-i18n-en';
							document.querySelectorAll('[data-i18n]').forEach((element) => {
								const value = element.getAttribute(attribute);
								if (value !== null && element.textContent !== value) {
									element.textContent = value;
								}
							});
							const placeholderAttr =
								lang === 'id' ? 'data-i18n-placeholder-id' : 'data-i18n-placeholder-en';
							document.querySelectorAll('[data-i18n-placeholder-en]').forEach((element) => {
								const value = element.getAttribute(placeholderAttr);
								if (value !== null) {
									element.setAttribute('placeholder', value);
								}
							});
							document.querySelectorAll('[data-lang-toggle-fallback]').forEach((button) => {
								const segments = button.querySelectorAll('.segment');
								if (segments.length >= 2) {
									segments[0].classList.toggle('active', lang === 'en');
									segments[1].classList.toggle('active', lang === 'id');
								}
								button.setAttribute(
									'aria-label',
									lang === 'en' ? 'Switch language to Indonesian' : 'Change language to English',
								);
							});
						};
					const fallbackToggleLanguage = () => {
						const current = normalizeLang(
							(typeof localStorage !== 'undefined' ? localStorage.getItem(storageKey) : null) ??
								document.documentElement.getAttribute('lang') ??
								'en',
						);
						const next = current === 'en' ? 'id' : 'en';
						persistLang(next);
						applyLanguage(next);
					};

					window.__applyLanguage = applyLanguage;
					
					const initDeferredLang = () => {
						window.addEventListener('portfolio:lang-change', (event) => {
							const langFromEvent =
								event instanceof CustomEvent ? normalizeLang(event.detail) : document.documentElement.lang;
							applyLanguage(langFromEvent);
						});
						window.addEventListener('storage', (event) => {
							if (event.key === storageKey && event.newValue) {
								applyLanguage(normalizeLang(event.newValue));
							}
						});
						document.addEventListener('click', (event) => {
							const target =
								event.target instanceof Element
									? event.target.closest('[data-lang-toggle-fallback]')
									: null;
							if (!target) return;
							const island = target.closest('astro-island');
							if (island && !island.hasAttribute('ssr')) return;
							event.preventDefault();
							fallbackToggleLanguage();
						});
					};

					let initial = 'en';
					try {
						const stored = typeof localStorage !== 'undefined' ? localStorage.getItem(storageKey) : null;
						if (stored) {
							initial = normalizeLang(stored);
						}
					} catch (err) {
						initial = 'en';
					}

				const init = () => {
					applyLanguage(initial);
					initDeferredLang();
				};
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', init, { once: true });
				} else {
					init();
				}
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#konten-utama">
			<LocaleText as="span" text={layoutCopy.skip} />
		</a>
		<div class="page page-grid">
			<aside class="sidebar" aria-label="Navigasi utama">
				<button class="sidebar__close" type="button" data-sidebar-close aria-label="Close menu">
					<span aria-hidden="true">×</span>
				</button>
				<div class="sidebar__brand">
					<h1>{profile.name}</h1>
				</div>
				<p class="sidebar__focus">
					<LocaleText as="span" text={profile.focusStack} />
				</p>
				<nav class="sidebar__nav">
					{navItems.map((item) => (
						<a data-nav-link data-target={item.id} href={item.to}>
							<LocaleText as="span" text={item.label} />
						</a>
					))}
				</nav>
				<div class="sidebar__cta">
					<CvDownloadButton client:idle />
					<a class="btn ghost" href="/#proyek">
						<LocaleText as="span" text={layoutCopy.explore} />
					</a>
					<a class="btn ghost" href={`mailto:${contact.email}`}>
						<LocaleText as="span" text={layoutCopy.cta} />
					</a>
				</div>
			</aside>
			<div class="page-content">
				<main id="konten-utama">
					<slot />
				</main>
				<footer class="site-footer section">
						<p class="thanks-word" style="text-align: center;">
							<LocaleText as="span" text={layoutCopy.footerThanks} />
						</p>
						<p class="footer-meta">
							© {new Date().getFullYear()} {profile.name}.{' '}
							<LocaleText as="span" text={layoutCopy.footerBuilt} />
						</p>
					</footer>
			</div>
			<div class="sidebar-overlay" data-sidebar-overlay></div>
		</div>
		<div class="global-toggles">
			<button
				class="sidebar-toggle"
				type="button"
				data-sidebar-toggle
				aria-label={layoutCopy.menu.en}
			>
				<svg viewBox="0 0 24 24" aria-hidden="true" class="sidebar-toggle__icon">
					<path
						d="M4 7h16M4 12h16M4 17h16"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
					/>
				</svg>
			</button>
			<div class="global-toggles__controls">
				<ThemeToggle client:idle />
				<LangToggle client:idle />
			</div>
		</div>
		<script is:inline>
			const root = document.documentElement;
			const animatedItems = Array.from(new Set(document.querySelectorAll('.section, [data-animate]')))
				.filter(item => item.id !== 'beranda'); // Exclude Hero section to prevent FCP/LCP delay
			
			// 1. Critical: Prevent FOUC for animations (Run immediately)
			const maxRevealDelay = 400;
			const revealStep = 35;
			animatedItems.forEach((item, index) => {
				item.classList.add('reveal');
				item.style.setProperty(
					'--reveal-delay',
					`${Math.min(index * revealStep, maxRevealDelay)}ms`,
				);
			});

			// 2. Non-critical: Event listeners and Observers (Run after paint)
			const initDeferred = () => {
				const toggle = document.querySelector('[data-sidebar-toggle]');
				const overlay = document.querySelector('[data-sidebar-overlay]');
				const navLinks = Array.from(document.querySelectorAll('[data-nav-link]'));
				const closeButtons = Array.from(document.querySelectorAll('[data-sidebar-close]'));

				const closeSidebar = () => {
					root.classList.remove('sidebar-open');
				};

				toggle?.addEventListener('click', () => {
					root.classList.toggle('sidebar-open');
				});
				overlay?.addEventListener('click', closeSidebar);
				closeButtons.forEach((btn) => btn.addEventListener('click', closeSidebar));
				navLinks.forEach((link) =>
					link.addEventListener('click', () => {
						closeSidebar();
					}),
				);

				window.addEventListener('keydown', (event) => {
					if (event.key === 'Escape') {
						closeSidebar();
					}
				});

				const setActiveNav = (id) => {
					navLinks.forEach((link) => {
						const targetId = link.getAttribute('data-target');
						if (targetId === id) {
							link.classList.add('active');
							link.setAttribute('aria-current', 'true');
						} else {
							link.classList.remove('active');
							link.removeAttribute('aria-current');
						}
					});
				};

				const sectionEntries = navLinks
					.map((link) => {
						const id = link.getAttribute('data-target');
						if (!id) return null;
						const element = document.getElementById(id);
						return element ? { id, element } : null;
					})
					.filter(Boolean);

				const hashTarget = window.location.hash?.replace('#', '');
				if (hashTarget) {
					setActiveNav(hashTarget);
				} else if (window.location.pathname.startsWith('/projects')) {
					setActiveNav('proyek');
				}

				if (sectionEntries.length) {
					setActiveNav(sectionEntries[0].id);
					const observer = new IntersectionObserver(
						(entries) => {
							const visible = entries
								.filter((entry) => entry.isIntersecting)
								.sort((a, b) => b.intersectionRatio - a.intersectionRatio);

							if (!visible.length) {
								return;
							}

							const id = visible[0].target.getAttribute('id');
							if (id) {
								setActiveNav(id);
							}
						},
						{ rootMargin: '-30% 0px -50% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] },
					);
					sectionEntries.forEach(({ element }) => observer.observe(element));
				}

				const animateObserver = 'IntersectionObserver' in window
					? new IntersectionObserver(
							(entries) => {
								entries.forEach((entry) => {
									if (entry.isIntersecting) {
										entry.target.classList.add('is-visible');
										animateObserver.unobserve(entry.target);
									}
								});
							},
							{ rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
					  )
					: null;

				animatedItems.forEach((item) => {
					if (animateObserver) {
						animateObserver.observe(item);
					} else {
						item.classList.add('is-visible');
					}
				});
			};
			
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initDeferred, { once: true });
			} else {
				initDeferred();
			}
		</script>
	</body>
</html>

<style>
	.global-toggles {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		position: fixed;
		top: 0;
		right: 0;
		z-index: 20000;
		background: var(--bg);
		border: 1px solid var(--border);
		border-top: none;
		border-right: none;
		border-radius: 0 0 0 12px;
		padding: 0.5rem 0.75rem;
	}

	.global-toggles__controls {
		display: flex;
		align-items: stretch;
		gap: 0.5rem;
		height: 2.5rem;
	}

	.global-toggles__controls > :global(*) {
		height: 100%;
	}

	.page-grid {
		display: grid;
		grid-template-columns: 260px 1fr;
		min-height: 100svh;
		position: relative;
	}

	.sidebar {
		position: sticky;
		top: 0;
		align-self: start;
		height: 100svh;
		max-height: 100svh;
		padding: 2rem 1.5rem;
		background: var(--bg);
		border-right: 1px solid var(--border);
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.sidebar__brand h1 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 600;
	}

	.sidebar__tagline {
		margin: 0;
		color: var(--muted);
		font-size: 0.875rem;
	}

	.sidebar__location {
		margin: 0.2rem 0 0;
		font-size: 0.8rem;
		color: var(--muted);
	}

	.sidebar__focus {
		font-size: 0.8rem;
		color: var(--muted);
	}

	.sidebar__nav {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}

	.sidebar__nav a {
		padding: 0.5rem 0.75rem;
		border-radius: 8px;
		color: var(--muted);
		font-weight: 500;
		font-size: 0.875rem;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.sidebar__nav a:hover,
	.sidebar__nav a.active {
		background: var(--surface-muted);
		color: var(--text);
	}

	.sidebar__cta {
		margin-top: auto;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.page-content {
		padding: 0 0 4rem;
		min-width: 0;
	}

	.sidebar-toggle {
		display: none;
		justify-content: center;
		padding: 0;
		border-radius: 8px;
		background: var(--bg);
		color: var(--text);
		border: 1px solid var(--border);
		align-items: center;
		white-space: nowrap;
		flex-shrink: 0;
		width: 2.5rem;
		height: 2.5rem;
	}

	.sidebar-toggle__icon {
		width: 1.25rem;
		height: 1.25rem;
	}

	.sidebar-overlay {
		display: none;
	}

	.sidebar__close {
		display: none;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		margin: -0.5rem -0.5rem 0.5rem auto;
		border-radius: 8px;
		border: none;
		background: transparent;
		color: var(--muted);
		transition: color 0.15s ease;
	}

	.sidebar__close:hover {
		color: var(--text);
	}

	.sidebar__close span[aria-hidden='true'] {
		font-size: 1.5rem;
		line-height: 1;
		font-weight: 300;
	}

	.site-footer {
		padding-bottom: 4rem;
	}

	.thanks-word {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-weight: 500;
		color: var(--muted);
		text-align: center;
	}

	.footer-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.footer-card h3 {
		margin: 0 0 0.5rem;
		font-size: 1.25rem;
	}

	.footer-meta {
		margin-top: 0.5rem;
		text-align: center;
		font-size: 0.8rem;
		color: var(--muted);
	}

	@media (max-width: 1100px) {
		.page-grid {
			grid-template-columns: 240px 1fr;
		}
	}

	@media (max-width: 900px) {
		.global-toggles {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			width: 100%;
			padding: 0.5rem 1rem;
			background: var(--bg);
			border-bottom: 1px solid var(--border);
			justify-content: space-between;
			z-index: 20000;
			gap: 0.75rem;
			border-radius: 0;
		}

		.global-toggles__controls {
			display: flex;
			align-items: stretch;
			gap: 0.5rem;
			flex: 1;
			justify-content: flex-end;
			flex-wrap: wrap;
			height: 2.5rem;
		}

		.global-toggles__controls > :global(*) {
			height: 100%;
		}

		.page-grid {
			grid-template-columns: 1fr;
		}

		.sidebar {
			position: fixed;
			inset: 0;
			height: 100lvh;
			max-height: 100lvh;
			padding: 1.5rem;
			padding-top: 5rem;
			overflow-y: auto;
			-webkit-overflow-scrolling: touch;
			transform: translateX(-100%);
			transition: transform 0.25s ease;
			z-index: 19000;
			background: var(--bg);
		}

		.sidebar-toggle {
			display: inline-flex;
		}

		.sidebar-overlay {
			display: block;
			position: fixed;
			inset: 0;
			background: rgba(0, 0, 0, 0.5);
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.25s ease;
			z-index: 18900;
		}

		html.sidebar-open .sidebar {
			transform: translateX(0);
		}

		html.sidebar-open .sidebar-overlay {
			opacity: 1;
			pointer-events: auto;
		}

		.page-content {
			padding-top: 1.5rem;
			min-width: 0;
		}

		.sidebar__close {
			display: inline-flex;
		}

		.sidebar__nav a {
			padding: 0.75rem 1rem;
			font-size: 1rem;
		}
	}
</style>
