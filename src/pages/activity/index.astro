---
import Layout from '../../layouts/Layout.astro';
import UnifiedActivityHub from '../../components/activity/UnifiedActivityHub.vue';
import LocaleText from '../../components/i18n/LocaleText.astro';
import initialDevData from '../../data/dev-activity-initial.json';
import initialCpData from '../../data/cp-data-initial.json';

const locale = (en: string, id: string) => ({ en, id });

const copy = {
  title: locale('Coding Activity', 'Aktivitas Coding'),
  subtitle: locale('Dev & CP', 'Dev & CP'),
  description: locale(
    'Daily coding activity log: software projects across GitHub & GitLab, and problem solving practice on TLX, Codeforces, LeetCode, and HackerRank.',
    'Catatan aktivitas ngoding harian: proyek software di GitHub & GitLab, serta latihan problem solving di TLX, Codeforces, LeetCode, dan HackerRank.'
  ),
  backToHome: locale('← Back to Home', '← Kembali ke Beranda'),
  devLink: locale('Development', 'Development'),
  cpLink: locale('CP Journey', 'CP Journey'),
};
---

<Layout
  title="Activity | Arief F-sa Wijaya"
  description={copy.description.en}
>
  <main class="activity-page">
    <div class="activity-header section">
      <div class="nav-row">
        <a href="/" class="back-link">
          <LocaleText as="span" text={copy.backToHome} />
        </a>
        <div class="direct-links">
          <a href="/development-activity" class="standalone-nav-link">
            <span><LocaleText as="span" text={copy.devLink} /></span>
            <span class="nav-arrow" aria-hidden="true">→</span>
          </a>
          <a href="/competitive-programming" class="standalone-nav-link">
            <span><LocaleText as="span" text={copy.cpLink} /></span>
            <span class="nav-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="title-row">
        <h1>
          <LocaleText as="span" text={copy.title} />
        </h1>
      </div>

      <p class="lead">
        <LocaleText as="span" text={copy.description} />
      </p>
    </div>

    <div class="activity-content section">
      <UnifiedActivityHub client:load initialDevData={initialDevData} initialCpData={initialCpData} />
    </div>
  </main>
</Layout>

<style>
  .activity-page {
    min-height: 100vh;
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .activity-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .title-row h1 {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin: 0;
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text);
  }

  .title-badge {
    font-size: 0.85rem;
    font-weight: 600;
    font-family: var(--font-mono, monospace);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    color: var(--muted);
    vertical-align: middle;
  }

  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .direct-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .standalone-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    border-radius: 0.5rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .standalone-nav-link:hover {
    border-color: var(--muted);
    color: var(--text);
  }

  .nav-arrow {
    transition: transform 0.15s ease;
  }

  .standalone-nav-link:hover .nav-arrow {
    transform: translateX(2px);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--text);
  }

  .lead {
    margin: 0;
    max-width: 800px;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .activity-content {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }
</style>
