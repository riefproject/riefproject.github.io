---
import DashboardPage from '../../components/layout/DashboardPage.astro'
import UnifiedActivityHub from '../../components/activity/UnifiedActivityHub.vue'
import initialDevData from '../../data/dev-activity.json'
import initialCpData from '../../data/cp-data.json'
import { t as locale } from '../../utils/i18n'
import { buildBreadcrumbSchema, buildCollectionPageSchema, normalizeSiteUrl } from '../../utils/seo'
import { localeFromPath, localizePath } from '../../utils/routing'

const siteUrl = normalizeSiteUrl(Astro.site)
const currentLocale = localeFromPath(Astro.url.pathname)
const isId = currentLocale === 'id'

const copy = {
  title: locale('Coding Activity', 'Aktivitas Coding'),
  subtitle: locale('Dev & CP', 'Dev & CP'),
  description: locale(
    'Daily coding activity log: software projects across GitHub & GitLab, and problem solving practice on TLX, Codeforces, LeetCode, and HackerRank.',
    'Catatan aktivitas ngoding harian: proyek software di GitHub & GitLab, serta latihan problem solving di TLX, Codeforces, LeetCode, dan HackerRank.'
  ),
  backToHome: locale('← Back to Home', '← Kembali ke Beranda'),
}
---

<DashboardPage
  metaTitle={isId ? 'Aktivitas Coding | Arief F-sa Wijaya' : 'Coding Activity | Arief F-sa Wijaya'}
  metaJsonLd={[
    buildCollectionPageSchema(
      siteUrl,
      localizePath('/activity', currentLocale),
      copy.title[currentLocale],
      copy.description[currentLocale],
      currentLocale
    ),
    buildBreadcrumbSchema(siteUrl, [
      { name: isId ? 'Beranda' : 'Home', path: localizePath('/', currentLocale) },
      {
        name: isId ? 'Aktivitas Coding' : 'Coding Activity',
        path: localizePath('/activity', currentLocale),
      },
    ]),
  ]}
  heading={copy.title}
  description={copy.description}
  backHref="/"
  backLabel={copy.backToHome}
  headerClass="activity-header"
  responsiveTop={false}>
  <UnifiedActivityHub
    client:load
    initialDevData={initialDevData}
    initialCpData={initialCpData}
    initialLocale={currentLocale}
  />
</DashboardPage>
