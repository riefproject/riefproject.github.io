---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import CpDashboard from '../../components/cp/CpDashboard.vue';
import initialCpData from '../../data/cp-data-initial.json';
import '../../styles/cp-shared.css';
import { t as locale } from '../../utils/i18n';

const copy = {
  title: locale('Competitive Programming Journey', 'Jejak Competitive Programming'),
  description: locale(
    'Real-time dashboard tracking problem solving milestones, live submissions, and platform statistics across TOKI (TLX), Codeforces, LeetCode, and HackerRank.',
    'Dashboard real-time yang melacak pencapaian problem solving, riwayat submisi, dan statistik lintas platform TOKI (TLX), Codeforces, LeetCode, dan HackerRank.'
  ),
  backToHome: locale('← Back to Home', '← Kembali ke Beranda'),
};
---

<Layout
  title="Competitive Programming Dashboard | Arief F-sa Wijaya"
  description={copy.description.en}
>
  <main class="cp-page">
    <PageHeader
      class="cp-header"
      backHref="/"
      backLabel={copy.backToHome}
      title={copy.title}
      description={copy.description}
    />

    <div class="cp-content section">
      <CpDashboard client:load initialData={initialCpData} />
    </div>
  </main>
</Layout>

<style>
  .cp-page {
    min-height: 100vh;
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .cp-content {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  @media (min-width: 768px) {
    .cp-page {
      padding-top: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .cp-page {
      padding-top: 4rem;
    }
  }
</style>
