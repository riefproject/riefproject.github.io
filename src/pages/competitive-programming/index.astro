---
import DashboardPage from '../../components/layout/DashboardPage.astro'
import CpDashboard from '../../components/cp/CpDashboard.vue'
import initialCpData from '../../data/cp-data.json'
import '../../styles/cp-shared.css'
import { t as locale } from '../../utils/i18n'
import { buildBreadcrumbSchema, buildCollectionPageSchema, normalizeSiteUrl } from '../../utils/seo'

const siteUrl = normalizeSiteUrl(Astro.site)

const copy = {
  title: locale('Competitive Programming Journey', 'Jejak Competitive Programming'),
  description: locale(
    'Real-time dashboard tracking problem solving milestones, live submissions, and platform statistics across TOKI (TLX), Codeforces, LeetCode, and HackerRank.',
    'Dashboard real-time yang melacak pencapaian problem solving, riwayat submisi, dan statistik lintas platform TOKI (TLX), Codeforces, LeetCode, dan HackerRank.'
  ),
  backToHome: locale('← Back to Home', '← Kembali ke Beranda'),
}
---

<DashboardPage
  metaTitle="Competitive Programming Dashboard | Arief F-sa Wijaya"
  metaJsonLd={[
    buildCollectionPageSchema(
      siteUrl,
      '/competitive-programming',
      copy.title.en,
      copy.description.en
    ),
    buildBreadcrumbSchema(siteUrl, [
      { name: 'Home', path: '/' },
      { name: 'Competitive Programming', path: '/competitive-programming' },
    ]),
  ]}
  heading={copy.title}
  description={copy.description}
  backHref="/"
  backLabel={copy.backToHome}
  headerClass="cp-header">
  <CpDashboard client:load initialData={initialCpData} />
</DashboardPage>
