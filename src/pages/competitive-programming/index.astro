---
import Layout from '../../layouts/Layout.astro';
import CpDashboard from '../../components/cp/CpDashboard.vue';
import LocaleText from '../../components/i18n/LocaleText.astro';
import initialCpData from '../../data/cp-data-initial.json';

const locale = (en: string, id: string) => ({ en, id });

const copy = {
  title: locale('Competitive Programming Journey', 'Jejak Competitive Programming'),
  description: locale(
    'Real-time dashboard tracking problem solving milestones, live submissions, and platform statistics across TOKI (TLX), Codeforces, LeetCode, and HackerRank.',
    'Dashboard real-time yang melacak pencapaian problem solving, riwayat submisi, dan statistik lintas platform TOKI (TLX), Codeforces, LeetCode, dan HackerRank.'
  ),
  backToHome: locale('← Back to Home', '← Kembali ke Beranda'),
};
---

<Layout
  title="Competitive Programming Dashboard | Arief F-sa Wijaya"
  description={copy.description.en}
>
  <main class="cp-page">
    <div class="cp-header section">
      <a href="/" class="back-link">
        <LocaleText as="span" text={copy.backToHome} />
      </a>
      <div class="title-row">
        <h1>
          <LocaleText as="span" text={copy.title} />
        </h1>
        <div class="cp-badge-tag">Live Analytics</div>
      </div>
      <p class="lead">
        <LocaleText as="span" text={copy.description} />
      </p>
    </div>

    <div class="cp-content section">
      <CpDashboard client:load initialData={initialCpData} />
    </div>
  </main>
</Layout>

<style>
  .cp-page {
    min-height: 100vh;
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .cp-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cp-badge-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #34d399;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    transition: all 0.2s;
    width: fit-content;
  }

  .back-link:hover {
    color: var(--accent-strong);
    transform: translateX(-4px);
  }

  .cp-header h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .cp-header .lead {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 68ch;
  }

  .cp-content {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  @media (min-width: 768px) {
    .cp-page {
      padding-top: 3rem;
    }

    .cp-header {
      gap: 1.25rem;
      margin-bottom: 3rem;
    }

    .cp-header .lead {
      font-size: 1.125rem;
    }
  }

  @media (min-width: 1024px) {
    .cp-page {
      padding-top: 4rem;
    }
  }
</style>
