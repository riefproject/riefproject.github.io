---
import DashboardPage from '../../../components/layout/DashboardPage.astro'
import CpProblemsExplorer from '../../../components/cp/CpProblemsExplorer.vue'
import initialCpData from '../../../data/cp-data.json'
import initialProblemsData from '../../../data/cp-problems.json'
import '../../../styles/cp-shared.css'
import { t as locale } from '../../../utils/i18n'
import {
  buildBreadcrumbSchema,
  buildCollectionPageSchema,
  normalizeSiteUrl,
} from '../../../utils/seo'

const siteUrl = normalizeSiteUrl(Astro.site)

const copy = {
  title: locale('Solved Competitive Programming Problems', 'Arsip Soal Competitive Programming'),
  description: locale(
    'Complete archive of solved problems across TOKI (TLX), Codeforces, LeetCode, and HackerRank with search, filters, and real-time links.',
    'Koleksi lengkap seluruh soal yang telah diselesaikan di TOKI (TLX), Codeforces, LeetCode, dan HackerRank dilengkapi pencarian, filter, dan tautan langsung.'
  ),
  backToDashboard: locale('← Back to CP Dashboard', '← Kembali ke Dashboard CP'),
}
---

<DashboardPage
  metaTitle="Solved Problems Archive | Arief F-sa Wijaya"
  metaJsonLd={[
    buildCollectionPageSchema(
      siteUrl,
      '/competitive-programming/problems',
      copy.title.en,
      copy.description.en
    ),
    buildBreadcrumbSchema(siteUrl, [
      { name: 'Home', path: '/' },
      { name: 'Competitive Programming', path: '/competitive-programming' },
      { name: 'Solved Problems', path: '/competitive-programming/problems' },
    ]),
  ]}
  heading={copy.title}
  description={copy.description}
  backHref="/competitive-programming"
  backLabel={copy.backToDashboard}
  headerClass="cp-header"
  headerVariant="compact"
  responsiveTop={false}>
  <CpProblemsExplorer
    client:load
    initialData={initialCpData}
    initialProblems={initialProblemsData}
  />
</DashboardPage>
