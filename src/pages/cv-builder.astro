---
export const prerender = false;

import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import CvBuilder from '../components/cv/CvBuilder.vue';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const cvDir = path.resolve(__dirname, '../data/cv');

const htmlPath = path.join(cvDir, 'source.html');
const cssPath = path.join(cvDir, 'source.css');

const initialHtml = fs.existsSync(htmlPath) ? fs.readFileSync(htmlPath, 'utf-8') : null;
const initialCss = fs.existsSync(cssPath) ? fs.readFileSync(cssPath, 'utf-8') : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CV Builder & Preview</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
    }
  </style>
</head>
<body>
  <CvBuilder client:only="vue" initialHtml={initialHtml} initialCss={initialCss} />
</body>
</html>
