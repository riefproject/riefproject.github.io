---
import DashboardPage from '../../components/layout/DashboardPage.astro'
import DevelopmentActivity from '../../components/dev/DevelopmentActivity.vue'
import initialDevData from '../../data/dev-activity.json'
import '../../styles/dev-shared.css'
import { t as locale } from '../../utils/i18n'
import { buildBreadcrumbSchema, buildCollectionPageSchema, normalizeSiteUrl } from '../../utils/seo'
import { localeFromPath, localizePath } from '../../utils/routing'

const siteUrl = normalizeSiteUrl(Astro.site)
const currentLocale = localeFromPath(Astro.url.pathname)
const isId = currentLocale === 'id'

const copy = {
  title: locale('Development Activity', 'Aktivitas Pengembangan'),
  description: locale(
    'Live dashboard tracking open-source and professional work across GitHub and GitLab — contribution calendars, streaks, pull requests, and language usage.',
    'Dashboard live yang melacak karya pengembangan open-source dan profesional di GitHub dan GitLab — kalender kontribusi, streak, pull request, dan penggunaan bahasa.'
  ),
  backToHome: locale('← Back to Home', '← Kembali ke Beranda'),
}
---

<DashboardPage
  metaTitle={
    isId ? 'Aktivitas Pengembangan | Arief F-sa Wijaya' : 'Development Activity | Arief F-sa Wijaya'
  }
  metaJsonLd={[
    buildCollectionPageSchema(
      siteUrl,
      localizePath('/development-activity', currentLocale),
      copy.title[currentLocale],
      copy.description[currentLocale],
      currentLocale
    ),
    buildBreadcrumbSchema(siteUrl, [
      { name: isId ? 'Beranda' : 'Home', path: localizePath('/', currentLocale) },
      {
        name: isId ? 'Aktivitas Pengembangan' : 'Development Activity',
        path: localizePath('/development-activity', currentLocale),
      },
    ]),
  ]}
  heading={copy.title}
  description={copy.description}
  backHref="/"
  backLabel={copy.backToHome}
  headerClass="dev-header">
  <DevelopmentActivity client:load initialData={initialDevData} initialLocale={currentLocale} />
</DashboardPage>
