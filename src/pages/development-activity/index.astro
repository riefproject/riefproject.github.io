---
import Layout from '../../layouts/Layout.astro';
import DevelopmentActivity from '../../components/dev/DevelopmentActivity.vue';
import LocaleText from '../../components/i18n/LocaleText.astro';
import initialDevData from '../../data/dev-activity-initial.json';

const locale = (en: string, id: string) => ({ en, id });

const copy = {
  title: locale('Development Activity', 'Aktivitas Pengembangan'),
  description: locale(
    'Live dashboard tracking open-source and professional development work across GitHub and GitLab — contribution calendars, streaks, pull requests, and language usage.',
    'Dashboard live yang melacak karya pengembangan open-source dan profesional di GitHub dan GitLab — kalender kontribusi, streak, pull request, dan penggunaan bahasa.'
  ),
  backToHome: locale('← Back to Home', '← Kembali ke Beranda'),
};
---

<Layout
  title="Development Activity | Arief F-sa Wijaya"
  description={copy.description.en}
>
  <main class="dev-page">
    <div class="dev-header section">
      <a href="/" class="back-link">
        <LocaleText as="span" text={copy.backToHome} />
      </a>
      <div class="title-row">
        <h1>
          <LocaleText as="span" text={copy.title} />
        </h1>
      </div>
      <p class="lead">
        <LocaleText as="span" text={copy.description} />
      </p>
    </div>

    <div class="dev-content section">
      <DevelopmentActivity client:load initialData={initialDevData} />
    </div>
  </main>
</Layout>

<style>
  .dev-page {
    min-height: 100vh;
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .dev-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    transition: all 0.2s;
    width: fit-content;
  }

  .back-link:hover {
    color: var(--accent-strong);
    transform: translateX(-4px);
  }

  .dev-header h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .dev-header .lead {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 68ch;
  }

  .dev-content {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  @media (min-width: 768px) {
    .dev-page {
      padding-top: 3rem;
    }

    .dev-header {
      gap: 1.25rem;
      margin-bottom: 3rem;
    }

    .dev-header .lead {
      font-size: 1.125rem;
    }
  }

  @media (min-width: 1024px) {
    .dev-page {
      padding-top: 4rem;
    }
  }
</style>
