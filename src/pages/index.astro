---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import SkillsSection from '../components/sections/SkillsSection.astro';
import StackSection from '../components/sections/StackSection.astro';
import ProjectsSection from '../components/sections/ProjectsSection.astro';
import ExperienceLegacy from '../components/sections/ExperienceLegacy.astro';
import AchievementsSection from '../components/sections/AchievementsSection.astro';
import EducationSection from '../components/sections/EducationSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import CPProfilesSection from '../components/sections/CPProfilesSection.astro';
import {
	profile,
	heroHighlights,
	stats,
	cpProfiles,
	focusAreas,
	skillCategories,
	toolbox,
} from '../data/profile';
import { socials } from '../data/social';
import { stackShowcase } from '../data/stack-showcase';
import {
	workExperiences,
	organizationalExperiences,
	personalExperiences,
} from '../data/experiences';
import { projects } from '../data/projects';
import { achievements, achievementTabs } from '../data/achievements';
import { education } from '../data/education';
import { contact } from '../data/contact';
---

<Layout>
	<HeroSection
		profile={profile}
		contact={contact}
		highlights={heroHighlights}
		stats={stats}
		socials={socials}
		toolbox={toolbox}
	/>
	<AboutSection profile={profile} focusAreas={focusAreas} />
	<SkillsSection categories={skillCategories} />
	<StackSection items={stackShowcase} />
	<ExperienceLegacy
		workExperiences={workExperiences}
		organizationalExperiences={organizationalExperiences}
		personalExperiences={personalExperiences}
	/>
	<CPProfilesSection profiles={cpProfiles} />
	<ProjectsSection projects={projects} />
	<AchievementsSection items={achievements} tabs={achievementTabs} />
	<EducationSection education={education} />
	<ContactSection contact={contact} socials={socials} />
</Layout>
