---
import Layout from '../layouts/Layout.astro'
import HeroSection from '../components/sections/HeroSection.astro'
import AboutSection from '../components/sections/AboutSection.astro'
import SkillsSection from '../components/sections/SkillsSection.astro'
import StackSection from '../components/sections/StackSection.astro'
import ProjectsSection from '../components/sections/ProjectsSection.astro'
import ExperienceSection from '../components/sections/ExperienceSection.astro'
import AchievementsSection from '../components/sections/AchievementsSection.astro'
import EducationSection from '../components/sections/EducationSection.astro'
import ContactSection from '../components/sections/ContactSection.astro'
import CPProfilesSection from '../components/sections/CPProfilesSection.astro'
import { ACHIEVEMENT_TABS } from '../data/achievementTabs'
import { buildProfilePageSchema, DEFAULT_DESCRIPTION, normalizeSiteUrl } from '../utils/seo'
import {
  getSingleton,
  getSortedProjects,
  getSortedExperiences,
  getSortedAchievements,
  getEducation,
  getCpProfiles,
  getStackShowcase,
} from '../utils/content-collections'

const [profileData, contactData, projects, expsSorted, achievements] = await Promise.all([
  getSingleton('profile'),
  getSingleton('contact'),
  getSortedProjects(),
  getSortedExperiences(),
  getSortedAchievements(),
])

if (!profileData || !contactData) {
  throw new Error('Missing profile or contact singleton content')
}

const workExperiences = expsSorted.filter((e) => e.type === 'work')
const organizationalExperiences = expsSorted.filter((e) => e.type === 'organizational')
const personalExperiences = expsSorted.filter((e) => e.type === 'personal')

const education = await getEducation()
const cpProfiles = await getCpProfiles()
const stackShowcase = await getStackShowcase()

const {
  name,
  role,
  tagline,
  location,
  availability,
  intro,
  bio,
  focusStack,
  heroHighlights,
  stats,
  focusAreas,
  skillCategories,
  toolbox,
} = profileData
const profile = { name, role, tagline, location, availability, intro, bio, focusStack }

const contact = contactData

const socialData = await getSingleton('social')
if (!socialData) {
  throw new Error('Missing social singleton content')
}
const socials = socialData.socials

const achievementTabs = ACHIEVEMENT_TABS
const siteUrl = normalizeSiteUrl(Astro.site)
---

<Layout
  title="Arief F-sa Wijaya — Software Engineer & Competitive Programmer"
  description={DEFAULT_DESCRIPTION}
  type="profile"
  jsonLd={buildProfilePageSchema(siteUrl)}>
  <HeroSection
    profile={profile}
    contact={contact}
    highlights={heroHighlights}
    stats={stats}
    socials={socials}
    toolbox={toolbox}
  />
  <AboutSection profile={profile} focusAreas={focusAreas} />
  <SkillsSection categories={skillCategories} />
  <StackSection items={stackShowcase} />
  <ExperienceSection
    workExperiences={workExperiences}
    organizationalExperiences={organizationalExperiences}
    personalExperiences={personalExperiences}
  />
  <CPProfilesSection profiles={cpProfiles} />
  <ProjectsSection projects={projects} />
  <AchievementsSection items={achievements} tabs={achievementTabs} />
  <EducationSection education={education} />
  <ContactSection contact={contact} socials={socials} />
</Layout>
