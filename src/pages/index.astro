---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import SkillsSection from '../components/sections/SkillsSection.astro';
import StackSection from '../components/sections/StackSection.astro';
import ProjectsSection from '../components/sections/ProjectsSection.astro';
import ExperienceLegacy from '../components/sections/ExperienceLegacy.astro';
import AchievementsSection from '../components/sections/AchievementsSection.astro';
import EducationSection from '../components/sections/EducationSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import CPProfilesSection from '../components/sections/CPProfilesSection.astro';
import { getCollection, getEntry } from 'astro:content';

const projectsCollection = await getCollection('projects');
const projects = projectsCollection.map(p => p.data).sort((a, b) => b.year - a.year);

const exps = await getCollection('experiences');
const workExperiences = exps.filter(e => e.data.type === 'work').map(e => e.data);
const organizationalExperiences = exps.filter(e => e.data.type === 'organizational').map(e => e.data);
const personalExperiences = exps.filter(e => e.data.type === 'personal').map(e => e.data);

const achievementsCollection = await getCollection('achievements');
const achievements = achievementsCollection.map(a => a.data);

const eduCollection = await getCollection('education');
const education = eduCollection.map(e => e.data);

const cpProfilesCollection = await getCollection('cp-profiles');
const cpProfiles = cpProfilesCollection.map(c => c.data);

const stackCollection = await getCollection('stack-showcase');
const stackShowcase = stackCollection.map(s => s.data);

const profileEntry = await getEntry('singletons', 'profile');
const { name, role, tagline, location, availability, intro, bio, focusStack, heroHighlights, stats, focusAreas, skillCategories, toolbox } = profileEntry.data;
const profile = { name, role, tagline, location, availability, intro, bio, focusStack };

const contactEntry = await getEntry('singletons', 'contact');
const contact = contactEntry.data;

const socialEntry = await getEntry('singletons', 'social');
const socials = socialEntry.data.socials;

// We need achievementTabs fallback since it was in data
const achievementTabs = [
  { id: 'competitions', name: { en: 'Competitions', id: 'Kompetisi' } },
  { id: 'certifications', name: { en: 'Certifications', id: 'Sertifikasi' } },
  { id: 'bootcamps', name: { en: 'Bootcamps', id: 'Bootcamp' } }
];
---

<Layout>
	<HeroSection
		profile={profile}
		contact={contact}
		highlights={heroHighlights}
		stats={stats}
		socials={socials}
		toolbox={toolbox}
	/>
	<AboutSection profile={profile} focusAreas={focusAreas} />
	<SkillsSection categories={skillCategories} />
	<StackSection items={stackShowcase} />
	<ExperienceLegacy
		workExperiences={workExperiences}
		organizationalExperiences={organizationalExperiences}
		personalExperiences={personalExperiences}
	/>
	<CPProfilesSection profiles={cpProfiles} />
	<ProjectsSection projects={projects} />
	<AchievementsSection items={achievements} tabs={achievementTabs} />
	<EducationSection education={education} />
	<ContactSection contact={contact} socials={socials} />
</Layout>
