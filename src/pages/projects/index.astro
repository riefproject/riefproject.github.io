---
import Layout from '../../layouts/Layout.astro';
import ProjectGallery from '../../components/projects/ProjectGallery.vue';
import LocaleText from '../../components/i18n/LocaleText.astro';
import { getCollection } from 'astro:content';
const projectsCollection = await getCollection('projects');
const projects = projectsCollection.map(p => p.data);

const locale = (en: string, id: string) => ({ en, id });

const categoryMap = new Map<string, typeof projects[0]['category']>();
projects.forEach((project) => {
	if (!categoryMap.has(project.categoryKey)) {
		categoryMap.set(project.categoryKey, project.category);
	}
});

const categories = [
	{ key: 'all', label: locale('All', 'Semua') },
	...Array.from(categoryMap.entries()).map(([key, label]) => ({ key, label })),
];

const copy = {
	title: locale('All Projects', 'Semua Proyek'),
	description: locale(
		'A complete collection of projects I\'ve built—from enterprise applications to experimental builds.',
		'Koleksi lengkap proyek yang saya bangun—dari aplikasi enterprise hingga eksperimen.'
	),
	backToHome: locale('← Back to Home', '← Kembali ke Home'),
};
---

<Layout title="Projects | Arief F-sa Wijaya" description={copy.description.en}>
	<main class="projects-page">
		<div class="projects-header section">
			<a href="/" class="back-link">
				<LocaleText as="span" text={copy.backToHome} />
			</a>
			<h1>
				<LocaleText as="span" text={copy.title} />
			</h1>
			<p class="lead">
				<LocaleText as="span" text={copy.description} />
			</p>
		</div>

		<div class="projects-content section">
			<ProjectGallery client:idle projects={projects} categories={categories} />
		</div>
	</main>
</Layout>

<style>
	.projects-page {
		min-height: 100vh;
		padding-top: 2rem;
		padding-bottom: 4rem;
	}

	.projects-header {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: 2.5rem;
		max-width: 1200px;
		margin-left: auto;
		margin-right: auto;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--text-muted);
		text-decoration: none;
		transition: all 0.2s;
		width: fit-content;
	}

	.back-link:hover {
		color: var(--accent);
		transform: translateX(-4px);
	}

	.projects-header h1 {
		margin: 0.5rem 0 0 0;
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 700;
		line-height: 1.1;
		color: var(--text);
	}

	.projects-header .lead {
		margin: 0.5rem 0 0 0;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--text-muted);
		max-width: 60ch;
	}

	.projects-content {
		max-width: 1400px;
		margin-left: auto;
		margin-right: auto;
	}

	@media (min-width: 768px) {
		.projects-page {
			padding-top: 3rem;
		}

		.projects-header {
			gap: 1.25rem;
			margin-bottom: 3rem;
		}

		.projects-header h1 {
			margin-top: 0.75rem;
		}

		.projects-header .lead {
			font-size: 1.125rem;
			margin-top: 0.75rem;
		}
	}

	@media (min-width: 1024px) {
		.projects-page {
			padding-top: 4rem;
		}
	}
</style>
