---
import DashboardPage from '../../components/layout/DashboardPage.astro'
import ProjectGallery from '../../components/projects/ProjectGallery.vue'
import { getCollection } from 'astro:content'
import { t as locale } from '../../utils/i18n'
import { buildBreadcrumbSchema, buildCollectionPageSchema, normalizeSiteUrl } from '../../utils/seo'
import { localeFromPath, localizePath } from '../../utils/routing'

const siteUrl = normalizeSiteUrl(Astro.site)
const currentLocale = localeFromPath(Astro.url.pathname)
const isId = currentLocale === 'id'
const projectsCollection = await getCollection('projects')
const projects = projectsCollection.map((p) => p.data)

const categoryMap = new Map<string, (typeof projects)[0]['category']>()
projects.forEach((project) => {
  if (!categoryMap.has(project.categoryKey)) {
    categoryMap.set(project.categoryKey, project.category)
  }
})

const categories = [
  { key: 'all', label: locale('All', 'Semua') },
  ...Array.from(categoryMap.entries()).map(([key, label]) => ({ key, label })),
]

const copy = {
  title: locale('All Projects', 'Semua Proyek'),
  description: locale(
    "A complete collection of software projects I've built—from enterprise applications and web platforms to experimental side projects.",
    'Koleksi lengkap proyek software yang saya bangun—dari aplikasi enterprise dan platform web hingga eksperimen sampingan.'
  ),
  backToHome: locale('← Back to Home', '← Kembali ke Beranda'),
}
---

<DashboardPage
  metaTitle={isId ? 'Proyek Software | Arief F-sa Wijaya' : 'Software Projects | Arief F-sa Wijaya'}
  metaJsonLd={[
    buildCollectionPageSchema(
      siteUrl,
      localizePath('/projects', currentLocale),
      copy.title[currentLocale],
      copy.description[currentLocale],
      currentLocale
    ),
    buildBreadcrumbSchema(siteUrl, [
      { name: isId ? 'Beranda' : 'Home', path: localizePath('/', currentLocale) },
      { name: isId ? 'Proyek' : 'Projects', path: localizePath('/projects', currentLocale) },
    ]),
  ]}
  heading={copy.title}
  description={copy.description}
  backHref="/"
  backLabel={copy.backToHome}
  headerClass="projects-header"
  headerVariant="flush"
  contentWidth="1400px"
  contentPadding={false}
  bottomPad="4rem">
  <ProjectGallery
    client:idle
    projects={projects}
    categories={categories}
    initialLocale={currentLocale}
  />
</DashboardPage>
